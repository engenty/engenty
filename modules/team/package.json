{
  "name": "@engenty/team",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/plugin": {
      "types": "./ui/plugin.ts",
      "default": "./dist/ui/plugin.js"
    },
    "./photos": {
      "types": "./src/schema/member-photos.ts",
      "default": "./dist/src/schema/member-photos.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts src/dal/supabase.ts src/dal/team-module-supabase.ts src/api/index.ts src/api/team-module-routes.ts src/api/habbo-avatar-routes.ts src/lib/habbo-avatar-prompt.ts src/schema/types.ts src/schema/zod.ts src/schema/taxonomies.ts src/schema/member-photos.ts src/services/org-tree.ts src/services/taxonomy-resolver.ts src/services/profile-name.ts ai/registrar.ts ui/index.ts ui/plugin.ts --format esm --clean",
    "dev": "tsup src/plugin.ts src/dal/supabase.ts src/dal/team-module-supabase.ts src/api/index.ts src/api/team-module-routes.ts src/api/habbo-avatar-routes.ts src/lib/habbo-avatar-prompt.ts src/schema/types.ts src/schema/zod.ts src/schema/taxonomies.ts src/schema/member-photos.ts src/services/org-tree.ts src/services/taxonomy-resolver.ts src/services/profile-name.ts ai/registrar.ts ui/index.ts ui/plugin.ts --format esm --watch",
    "test": "vitest run --root ../.. modules/team/",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/api-contracts": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/auth-ui": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/import": "workspace:*",
    "@engenty/live-cache": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/projects": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/tasks": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.116.0",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.6",
    "ai": "7.0.102",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.46.0",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "uuidv7": "^1.2.1",
    "write-excel-file": "^4.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
