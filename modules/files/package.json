{
  "name": "@engenty/files-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/ui/plugin.js",
  "types": "./ui/plugin.ts",
  "exports": {
    "./ui/plugin": {
      "types": "./ui/plugin.ts",
      "default": "./dist/ui/plugin.js"
    },
    "./ui/file-manager": {
      "types": "./ui/file-manager.tsx",
      "default": "./dist/ui/file-manager.js"
    },
    "./ui/components/connect-folder-dialog": {
      "types": "./ui/components/connect-folder-dialog.tsx",
      "default": "./ui/components/connect-folder-dialog.tsx"
    },
    "./ui/components/file-space-actions": {
      "types": "./ui/components/file-space-actions.tsx",
      "default": "./ui/components/file-space-actions.tsx"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts ui/plugin.ts ui/file-manager.tsx --format esm --clean",
    "dev": "tsup src/plugin.ts ui/plugin.ts ui/file-manager.tsx --format esm --watch",
    "lint": "biome check .",
    "test": "vitest run --root ../.. modules/files/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/ai-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/connections-local-files": "workspace:*",
    "@engenty/connections-sdk": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/import": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
