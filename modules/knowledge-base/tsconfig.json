{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "ai/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx"
  ],
  "extends": "../../tsconfig.base.json"
}
