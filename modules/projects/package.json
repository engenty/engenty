{
  "name": "@engenty/projects",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/plugin": {
      "types": "./ui/plugin.ts",
      "default": "./dist/ui/plugin.js"
    },
    "./ui/public-plugin": {
      "types": "./ui/public-plugin.ts",
      "default": "./dist/ui/public-plugin.js"
    },
    "./ui/portal": {
      "types": "./ui/portal.ts",
      "default": "./dist/ui/portal.js"
    },
    "./ai/registrar": {
      "types": "./ai/registrar.ts",
      "default": "./dist/ai/registrar.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts src/dal/supabase.ts src/dal/portal-supabase.ts src/api/index.ts src/schema/types.ts src/schema/zod.ts ai/registrar.ts ai/agents/projects-assist.ts ai/tools/load-project.ts ai/tools/load-projects-list.ts ai/tools/load-project-tasks.ts ai/tools/manage-project.ts ai/tools/manage-project-phase.ts ai/tools/manage-project-task.ts ui/index.ts ui/plugin.ts ui/public-plugin.ts ui/portal.ts --format esm --clean",
    "dev": "tsup src/plugin.ts src/dal/supabase.ts src/dal/portal-supabase.ts src/api/index.ts src/schema/types.ts src/schema/zod.ts ai/registrar.ts ai/agents/projects-assist.ts ai/tools/load-project.ts ai/tools/load-projects-list.ts ai/tools/load-project-tasks.ts ai/tools/manage-project.ts ai/tools/manage-project-phase.ts ai/tools/manage-project-task.ts ui/index.ts ui/plugin.ts ui/public-plugin.ts ui/portal.ts --format esm --watch",
    "test": "vitest run --config vitest.config.ts",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/api-contracts": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/auth-ui": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/live-cache": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/queue": "workspace:*",
    "@engenty/tasks": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/tiptap-editor": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@hookform/resolvers": "^5.9.1",
    "@mastra/core": "1.67.0",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "uuidv7": "^1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
