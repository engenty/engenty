{
  "name": "@engenty/memory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./dal": {
      "types": "./dist/dal/index.d.ts",
      "default": "./dist/dal/index.js"
    },
    "./schema": {
      "types": "./dist/schema/zod.d.ts",
      "default": "./dist/schema/zod.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts src/dal/index.ts src/dal/contracts.ts src/dal/supabase.ts src/dal/memory-retrieval-source.ts src/schema/zod.ts src/api/index.ts src/api/gateway-methods.ts --format esm --dts --clean",
    "dev": "tsup src/plugin.ts src/dal/index.ts src/dal/contracts.ts src/dal/supabase.ts src/dal/memory-retrieval-source.ts src/schema/zod.ts src/api/index.ts src/api/gateway-methods.ts --format esm --dts --watch",
    "test": "vitest run --root ../.. modules/memory/",
    "lint": "echo 'No lint yet'"
  },
  "dependencies": {
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/retrieval": "workspace:*",
    "@engenty/search-index": "workspace:*",
    "@supabase/supabase-js": "^2.108.2",
    "uuidv7": "^1.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@types/node": "^26.0.0"
  }
}
