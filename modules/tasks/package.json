{
  "name": "@engenty/tasks",
  "version": "0.0.1",
  "description": "Canonical goals and tasks for human and agent collaboration",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./dist/src/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/plugin.d.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui/plugin": {
      "types": "./dist/ui/plugin.d.ts",
      "default": "./dist/ui/plugin.js"
    },
    "./ui/api": {
      "types": "./dist/ui/api.d.ts",
      "default": "./dist/ui/api.js"
    },
    "./ui/assignee": {
      "types": "./dist/ui/assignee.d.ts",
      "default": "./dist/ui/assignee.js"
    },
    "./lib/task-workspace": {
      "types": "./dist/src/lib/task-workspace.d.ts",
      "default": "./dist/src/lib/task-workspace.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts src/dal/supabase.ts src/api/index.ts src/schema/types.ts src/schema/zod.ts src/lib/task-workspace.ts ui/plugin.ts ui/api.ts ui/assignee.ts --format esm --dts --clean",
    "dev": "tsup src/plugin.ts src/dal/supabase.ts src/api/index.ts src/schema/types.ts src/schema/zod.ts src/lib/task-workspace.ts ui/plugin.ts ui/api.ts ui/assignee.ts --format esm --dts --watch",
    "test": "vitest run --config vitest.config.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/environment": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/live-cache": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7",
    "uuidv7": "^1.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
