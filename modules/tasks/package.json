{
  "name": "@engenty/tasks",
  "version": "0.0.1",
  "description": "Canonical tasks for human and agent collaboration",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui/plugin": {
      "types": "./ui/plugin.ts",
      "default": "./dist/ui/plugin.js"
    },
    "./ui/api": {
      "types": "./ui/api.ts",
      "default": "./dist/ui/api.js"
    },
    "./ui/assignee": {
      "types": "./ui/assignee.ts",
      "default": "./dist/ui/assignee.js"
    },
    "./ui/comments": {
      "types": "./ui/comments.ts",
      "default": "./dist/ui/comments.js"
    },
    "./ui/work-tabs": {
      "types": "./ui/work-tabs.ts",
      "default": "./dist/ui/work-tabs.js"
    },
    "./lib/task-workspace": {
      "types": "./src/lib/task-workspace.ts",
      "default": "./dist/src/lib/task-workspace.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts src/dal/supabase.ts src/api/index.ts src/schema/types.ts src/schema/zod.ts src/lib/task-workspace.ts ui/plugin.ts ui/api.ts ui/assignee.ts ui/comments.ts --format esm --clean",
    "dev": "tsup src/plugin.ts src/dal/supabase.ts src/api/index.ts src/schema/types.ts src/schema/zod.ts src/lib/task-workspace.ts ui/plugin.ts ui/api.ts ui/assignee.ts ui/comments.ts --format esm --watch",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/approvals-sdk": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-ui": "workspace:*",
    "@engenty/notifications-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/environment": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/live-cache": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/tenant-settings": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "uuidv7": "^1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
