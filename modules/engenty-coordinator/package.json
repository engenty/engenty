{
  "name": "@engenty/engenty-coordinator",
  "version": "0.0.1",
  "description": "Goal-driven orchestrator agent for Engenty — decomposes goals into tasks and monitors progress.",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./dist/src/plugin.d.ts",
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "exports": {
    ".": {
      "types": "./dist/src/plugin.d.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ai/registrar": {
      "types": "./dist/ai/registrar.d.ts",
      "default": "./dist/ai/registrar.js"
    }
  },
  "scripts": {
    "build": "tsup src/plugin.ts ai/registrar.ts --format esm --dts --clean",
    "dev": "tsup src/plugin.ts ai/registrar.ts --format esm --dts --watch",
    "test": "vitest run --config vitest.config.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "@engenty/ai-core": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
