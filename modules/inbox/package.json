{
  "name": "@engenty/inbox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./dist/src/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/plugin.d.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui/plugin": {
      "types": "./dist/ui/plugin.d.ts",
      "default": "./dist/ui/plugin.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts src/dal/contracts.ts src/dal/supabase.ts src/schema/types.ts src/schema/zod.ts src/sync/sync-service.ts ui/plugin.ts --format esm --dts --clean",
    "dev": "tsup src/plugin.ts src/dal/contracts.ts src/dal/supabase.ts src/schema/types.ts src/schema/zod.ts src/sync/sync-service.ts ui/plugin.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "echo 'No lint yet'"
  },
  "dependencies": {
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/connections-sdk": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/retrieval": "workspace:*",
    "@engenty/search-index": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@mastra/core": "1.49.0",
    "@supabase/supabase-js": "^2.108.2",
    "ai": "6.0.116",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7",
    "uuidv7": "^1.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
