{
  "id": "inbox",
  "name": "Inbox",
  "emoji": "📬",
  "description": "Synced email inbox over connected mail accounts (connections framework)",
  "version": "0.0.1",
  "kind": "module",
  "category": "work",
  "provides": [
    "module.inbox",
    "module.inbox.read",
    "module.inbox.write",
    "ui.route.module.inbox"
  ],
  "capabilities": {
    "operations": true,
    "ai": true,
    "frontendTools": true
  },
  "requires": ["module.connections"],
  "connections": [
    {
      "capability": "stream",
      "bindOperation": "inbox_account_bind"
    }
  ],
  "mountOperation": "inbox_space_mount",
  "placement": "space"
}
