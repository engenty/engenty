{
  "name": "@engenty/engenty-copilot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/ui/plugin.js",
  "types": "./ui/plugin.ts",
  "exports": {
    "./ai": {
      "types": "./ai/index.ts",
      "default": "./dist/ai/index.js"
    },
    "./ai/frontend-tools": {
      "types": "./ai/frontend-tools/index.ts",
      "default": "./dist/ai/frontend-tools/index.js"
    },
    "./ai/frontend-tools/register": {
      "types": "./ai/frontend-tools/register-all.ts",
      "default": "./dist/ai/frontend-tools/register-all.js"
    },
    "./ai/ui/frontend-tools": {
      "types": "./ai/frontend-tools/register-all.ts",
      "default": "./dist/ai/frontend-tools/register-all.js"
    },
    "./lib/copilot-workspace": {
      "types": "./src/lib/copilot-workspace.ts",
      "default": "./dist/src/lib/copilot-workspace.js"
    },
    "./lib/ensure-copilot-user-workspace-prefix": {
      "types": "./src/lib/ensure-copilot-user-workspace-prefix.ts",
      "default": "./dist/src/lib/ensure-copilot-user-workspace-prefix.js"
    },
    "./paths": {
      "types": "./ui/paths.ts",
      "default": "./dist/ui/paths.js"
    },
    "./ui/effort-control": {
      "types": "./ui/components/chat/copilot-effort-control.tsx",
      "default": "./dist/ui/components/chat/copilot-effort-control.js"
    },
    "./ui/model-chooser-control": {
      "types": "./ui/components/chat/copilot-model-chooser-control.tsx",
      "default": "./dist/ui/components/chat/copilot-model-chooser-control.js"
    },
    "./ui/plugin": {
      "types": "./ui/plugin.ts",
      "default": "./dist/ui/plugin.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/auth-ui": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/generative-ui": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/live-cache": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@mastra/core": "1.67.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
