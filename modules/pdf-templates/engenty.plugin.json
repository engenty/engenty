{
  "id": "pdf-templates",
  "name": "PDF Templates",
  "description": "Shared PDF template storage, preview, and editor integration",
  "version": "0.0.1",
  "kind": "module",
  "category": "commercial",
  "provides": [
    "module.pdf-templates",
    "module.pdf-templates.read",
    "module.pdf-templates.write",
    "ui.route.module.pdf-templates"
  ],
  "capabilities": {
    "operations": true,
    "ai": false,
    "frontendTools": false
  },
  "supabase": {
    "storageBuckets": [
      {
        "name": "module-pdf-templates-assets",
        "public": true,
        "fileSizeLimit": "10MiB",
        "allowedMimeTypes": [
          "image/png",
          "image/jpeg",
          "image/gif",
          "image/webp"
        ]
      }
    ]
  }
}
