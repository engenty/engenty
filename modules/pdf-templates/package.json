{
  "name": "@engenty/pdf-templates-module",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./dist/src/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/plugin.d.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui/plugin": {
      "types": "./dist/ui/plugin.d.ts",
      "default": "./dist/ui/plugin.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts src/dal/index.ts src/api/index.ts src/schema/types.ts src/schema/zod.ts ui/plugin.ts --format esm --dts --clean",
    "dev": "tsup src/plugin.ts src/dal/index.ts src/api/index.ts src/schema/types.ts src/schema/zod.ts ui/plugin.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/api-client": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/pdf-service": "workspace:*",
    "@engenty/pdf-templates": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuidv7": "^1.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@engenty/test-kit": "workspace:*"
  }
}
