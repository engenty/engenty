{
  "name": "@engenty/contacts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/plugin": {
      "types": "./ui/plugin.ts",
      "default": "./dist/ui/plugin.js"
    },
    "./ai/registrar": {
      "types": "./ai/registrar.ts",
      "default": "./dist/ai/registrar.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts src/cli/index.ts src/dal/index.ts src/dal/contracts.ts src/dal/supabase.ts src/dal/pathing.ts src/api/index.ts src/schema/index.ts src/schema/types.ts src/schema/zod.ts src/schema/contacts-types.ts src/services/contact-name.ts src/services/contact-input.ts ai/registrar.ts ai/artifacts/contacts-suggestion-artifact.ts ai/schema/contact-suggestion-schema.ts ui/index.ts ui/plugin.ts --format esm --clean",
    "dev": "tsup src/plugin.ts src/cli/index.ts src/dal/index.ts src/dal/supabase.ts src/dal/pathing.ts src/api/index.ts src/schema/index.ts src/schema/types.ts src/schema/zod.ts src/schema/contacts-types.ts ai/registrar.ts ai/artifacts/contacts-suggestion-artifact.ts ai/schema/contact-suggestion-schema.ts ui/index.ts ui/plugin.ts --format esm --watch",
    "test": "vitest run --root ../.. modules/contacts/",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/api-contracts": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/auth-ui": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/import": "workspace:*",
    "@engenty/live-cache": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/retrieval": "workspace:*",
    "@engenty/search-index": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@mastra/core": "1.61.0",
    "@supabase/supabase-js": "^2.108.2",
    "ai": "7.0.58",
    "commander": "^15.0.0",
    "lucide-react": "^1.21.0",
    "nuqs": "^2.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.1",
    "uuidv7": "^1.2.1",
    "write-excel-file": "^4.1.1",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
