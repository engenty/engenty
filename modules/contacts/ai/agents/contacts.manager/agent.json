{
  "$schema": "engenty/ai-agent-manifest/v1",
  "id": "contacts.manager",
  "name": "Contacts Manager",
  "description": "Persona agent for researching contacts, enriching organisation records from public sources, extracting contacts from email, and HITL field suggestions.",
  "module_id": "contacts",
  "instruction_keys": ["contacts.manager.agents", "contacts.manager.soul"],
  "skills": ["contacts-search"],
  "tools": [
    "engentyApiCatalog",
    "engentyApi",
    "createContact",
    "loadContact",
    "createContactRelation",
    "extractContactFromEmail",
    "web_search",
    "memory_save",
    "memory_record_search",
    "memory_record_archive"
  ]
}
