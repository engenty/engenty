{
  "name": "@engenty/connections",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui/plugin": {
      "types": "./ui/plugin.ts",
      "default": "./dist/ui/plugin.js"
    },
    "./ui/extensions": {
      "types": "./ui/extensions.ts",
      "default": "./dist/ui/extensions.js"
    },
    "./ui/api": {
      "types": "./ui/api.ts",
      "default": "./ui/api.ts"
    },
    "./ui/queries": {
      "types": "./ui/queries.ts",
      "default": "./ui/queries.ts"
    },
    "./ui/lib/policy": {
      "types": "./ui/lib/policy.ts",
      "default": "./ui/lib/policy.ts"
    },
    "./ui/marketplace": {
      "types": "./ui/components/marketplace/plugin-marketplace-dialog.tsx",
      "default": "./ui/components/marketplace/plugin-marketplace-dialog.tsx"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts ui/plugin.ts ui/extensions.ts --format esm --clean",
    "dev": "tsup src/plugin.ts ui/plugin.ts ui/extensions.ts --format esm --watch",
    "test": "vitest run --root ../.. --passWithNoTests modules/connections/src/ modules/connections/ui/",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/ai-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/connections-sdk": "workspace:*",
    "@engenty/platform-settings": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
