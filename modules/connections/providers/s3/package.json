{
  "name": "@engenty/connections-s3",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/src/plugin.js"
    }
  },
  "engenty": {},
  "scripts": {
    "build": "tsup src/plugin.ts --format esm --clean --out-dir dist/src",
    "dev": "tsup src/plugin.ts --format esm --watch --out-dir dist/src",
    "test": "vitest run",
    "lint": "echo 'No lint yet'"
  },
  "dependencies": {
    "@engenty/connections-sdk": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "aws4fetch": "^1.0.20",
    "fast-xml-parser": "^5.3.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
