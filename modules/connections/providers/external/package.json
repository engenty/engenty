{
  "name": "@engenty/connections-external",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./dist/src/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/plugin.d.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui/plugin": {
      "types": "./dist/ui/plugin.d.ts",
      "default": "./dist/ui/plugin.js"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts ui/plugin.ts --format esm --dts --clean",
    "dev": "tsup src/plugin.ts ui/plugin.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "echo 'No lint yet'"
  },
  "dependencies": {
    "@engenty/api-client": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/connections": "workspace:*",
    "@engenty/connections-sdk": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@executor-js/plugin-openapi": "1.5.29",
    "@supabase/supabase-js": "^2.108.2",
    "effect": "4.0.0-beta.59",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "sonner": "^2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
