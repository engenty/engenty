{
  "stripe": {
    "version": 3,
    "domain": "stripe.com",
    "credentials": {
      "stripe_api_key": {
        "label": "Stripe API key",
        "type": "api_key"
      },
      "stripe_mcp_oauth": {
        "label": "Stripe MCP OAuth authorization",
        "type": "oauth2"
      },
      "stripe_cli_session": {
        "label": "Stripe CLI authenticated session / CLI-generated restricted key",
        "type": "compound"
      }
    },
    "detect": {},
    "surfaces": [
      {
        "type": "http",
        "spec": "https://raw.githubusercontent.com/stripe/openapi/master/openapi/spec3.json",
        "url": "https://api.stripe.com",
        "slug": "stripe-api",
        "name": "Stripe API",
        "docs": "https://docs.stripe.com/api",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "stripe_api_key",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Bearer"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "mcp",
        "url": "https://mcp.stripe.com",
        "transports": ["streamable-http"],
        "slug": "stripe-mcp-server",
        "name": "Stripe MCP server",
        "docs": "https://docs.stripe.com/mcp",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "stripe_mcp_oauth",
                  "mechanics": {
                    "source": "well-known"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "stripe_api_key",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Bearer"
                  }
                },
                {
                  "id": "stripe_api_key",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Stripe-Account"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "cli",
        "command": "stripe",
        "slug": "stripe-cli",
        "name": "Stripe CLI",
        "docs": "https://docs.stripe.com/stripe-cli",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "stripe_cli_session",
                  "mechanics": {
                    "source": "cli",
                    "command": "stripe login"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "stripe_api_key",
                  "mechanics": {
                    "source": "cli",
                    "command": "stripe login --api-key <key>"
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "github": {
    "version": 3,
    "domain": "github.com",
    "credentials": {
      "github_pat": {
        "label": "GitHub personal access token (fine-grained or classic)",
        "type": "bearer"
      },
      "github_app_installation_token": {
        "label": "GitHub App credentials (app registration + private key, used to mint installation or user tokens)",
        "type": "compound"
      },
      "github_oauth_app": {
        "label": "GitHub OAuth app",
        "type": "oauth2"
      }
    },
    "detect": {},
    "surfaces": [
      {
        "type": "mcp",
        "url": "https://api.githubcopilot.com/mcp/",
        "transports": ["streamable-http"],
        "slug": "github-mcp-server",
        "name": "GitHub MCP Server",
        "docs": "https://github.com/github/github-mcp-server",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "github_pat",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Bearer"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "github_oauth_app",
                  "mechanics": {
                    "source": "unknown"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "http",
        "url": "https://api.github.com",
        "slug": "github-rest-api",
        "name": "GitHub REST API",
        "docs": "https://docs.github.com/en/rest",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "github_pat",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Bearer"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "github_app_installation_token",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Bearer"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "github_oauth_app",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Bearer"
                  }
                }
              ]
            }
          ]
        },
        "requiredHeaders": [
          {
            "name": "X-GitHub-Api-Version",
            "source": {
              "kind": "static",
              "value": "2022-11-28"
            },
            "description": "GitHub recommends sending an API version header for REST requests; docs also list newer versions in the docs UI."
          },
          {
            "name": "Accept",
            "source": {
              "kind": "static",
              "value": "application/vnd.github+json"
            },
            "description": "Recommended media type for REST requests."
          }
        ]
      }
    ]
  },
  "atlassian": {
    "version": 3,
    "domain": "atlassian.com",
    "credentials": {
      "atlassian_api_token": {
        "label": "Atlassian account email + API token for direct REST/GraphQL calls",
        "type": "compound"
      },
      "atlassian_oauth_app": {
        "label": "Atlassian OAuth 2.0 (3LO) app client credentials",
        "type": "oauth2"
      },
      "twg_cli_oauth": {
        "label": "TWG CLI local OAuth 2.1 session",
        "type": "oauth2"
      },
      "atlassian_admin_api_key": {
        "label": "Atlassian Admin API key for TWG CLI admin auth",
        "type": "api_key"
      },
      "bitbucket_token": {
        "label": "Bitbucket token for Bitbucket API and TWG CLI Bitbucket commands",
        "type": "api_key"
      },
      "rovo_mcp_oauth": {
        "label": "Atlassian Rovo MCP OAuth session",
        "type": "oauth2"
      }
    },
    "detect": {},
    "surfaces": [
      {
        "type": "http",
        "url": "https://<site>.atlassian.net/rest/api/3",
        "slug": "jira-cloud-rest-api",
        "name": "Jira Cloud REST API",
        "docs": "https://developer.atlassian.com/cloud/jira/platform/rest/v3/intro/",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "atlassian_api_token",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Basic"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "atlassian_oauth_app",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Bearer"
                  }
                }
              ]
            }
          ]
        },
        "variables": [
          {
            "name": "site",
            "in": "url",
            "resolveFrom": "your Jira Cloud site subdomain",
            "description": "Jira Cloud site hostname prefix"
          }
        ]
      }
    ]
  },
  "gitlab": {
    "version": 3,
    "domain": "gitlab.com",
    "credentials": {
      "gitlab_oauth_app": {
        "label": "GitLab OAuth application (client ID + client secret)",
        "type": "oauth2"
      },
      "gitlab_pat": {
        "label": "GitLab personal access token",
        "type": "api_key"
      },
      "gitlab_project_token": {
        "label": "GitLab project access token",
        "type": "api_key"
      },
      "gitlab_group_token": {
        "label": "GitLab group access token",
        "type": "api_key"
      },
      "gitlab_ci_job_token": {
        "label": "GitLab CI/CD job token",
        "type": "bearer"
      }
    },
    "detect": {
      "auth": {
        "oauth": {
          "authorizationServers": ["https://gitlab.com"],
          "authorizationEndpoint": "https://gitlab.com/oauth/authorize",
          "tokenEndpoint": "https://gitlab.com/oauth/token",
          "scopes": ["mcp", "mcp_orbit"],
          "registrationEndpoint": "https://gitlab.com/oauth/register",
          "dcr": true,
          "cimd": false,
          "grantTypes": [
            "authorization_code",
            "client_credentials",
            "device_code",
            "refresh_token"
          ]
        }
      }
    },
    "surfaces": [
      {
        "type": "mcp",
        "transports": ["stdio"],
        "slug": "gitlab-mcp-server-via-glab",
        "name": "GitLab MCP server via glab",
        "docs": "https://docs.gitlab.com/cli/mcp/",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "gitlab_oauth_app",
                  "mechanics": {
                    "source": "cli",
                    "command": "glab auth login --web"
                  }
                },
                {
                  "id": "gitlab_oauth_app",
                  "mechanics": {
                    "source": "cli",
                    "command": "glab mcp serve"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "gitlab_oauth_app",
                  "mechanics": {
                    "source": "cli",
                    "command": "glab auth login --device"
                  }
                },
                {
                  "id": "gitlab_oauth_app",
                  "mechanics": {
                    "source": "cli",
                    "command": "glab mcp serve"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "gitlab_pat",
                  "mechanics": {
                    "source": "cli",
                    "command": "glab auth login --stdin",
                    "env": [
                      "GITLAB_TOKEN",
                      "GITLAB_ACCESS_TOKEN",
                      "OAUTH_TOKEN"
                    ]
                  }
                },
                {
                  "id": "gitlab_pat",
                  "mechanics": {
                    "source": "cli",
                    "command": "glab mcp serve"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "gitlab_ci_job_token",
                  "mechanics": {
                    "source": "cli",
                    "command": "glab auth login --job-token $CI_JOB_TOKEN",
                    "env": ["CI_JOB_TOKEN"]
                  }
                },
                {
                  "id": "gitlab_ci_job_token",
                  "mechanics": {
                    "source": "cli",
                    "command": "glab mcp serve"
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  },
