  "resend": {
    "version": 3,
    "domain": "resend.com",
    "credentials": {
      "resend_api_key": {
        "label": "Resend API key",
        "type": "api_key"
      },
      "resend_oauth": {
        "label": "OAuth 2.0",
        "type": "oauth2"
      }
    },
    "detect": {
      "auth": {
        "oauth": {
          "authorizationServers": ["https://api.resend.com"],
          "authorizationEndpoint": "https://api.resend.com/oauth/authorize",
          "tokenEndpoint": "https://api.resend.com/oauth/token",
          "protectedResourceUrl": "https://resend.com/.well-known/oauth-protected-resource",
          "scopes": ["full_access", "emails:send"],
          "registrationEndpoint": "https://api.resend.com/oauth/register",
          "dcr": true,
          "cimd": true,
          "grantTypes": ["authorization_code", "refresh_token"]
        },
        "mcp": [
          {
            "url": "https://mcp.resend.com/mcp",
            "type": "oauth2",
            "authorizationServer": "https://api.resend.com",
            "authorizationServerMetadataFetched": true,
            "dcr": true,
            "cimd": true
          }
        ]
      }
    },
    "surfaces": [
      {
        "type": "http",
        "spec": "https://resend.com/openapi.yaml",
        "specAlternates": ["https://resend.com/openapi.json"],
        "url": "https://api.resend.com",
        "slug": "resend-rest-api-2",
        "name": "Resend REST API",
        "docs": "https://resend.com/docs/api-reference/introduction",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "resend_api_key",
                  "mechanics": {
                    "source": "spec",
                    "scheme": "bearerAuth"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "resend_api_key",
                  "mechanics": {
                    "source": "http",
                    "in": "header",
                    "headerName": "Authorization",
                    "scheme": "Bearer"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "mcp",
        "url": "https://mcp.resend.com/mcp",
        "transports": ["streamable-http"],
        "slug": "resend-mcp",
        "name": "Resend MCP",
        "docs": "https://resend.com/docs/mcp-server",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "resend_oauth",
                  "mechanics": {
                    "source": "well-known"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "cli",
        "command": "resend",
        "slug": "resend-cli",
        "name": "Resend CLI",
        "docs": "https://resend.com/docs/cli",
        "auth": {
          "status": "required",
          "entries": [
            {
              "use": [
                {
                  "id": "resend_api_key",
                  "mechanics": {
                    "source": "cli",
                    "command": "resend login"
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "resend_api_key",
                  "mechanics": {
                    "source": "cli",
                    "env": ["RESEND_API_KEY"]
                  }
                }
              ]
            },
            {
              "use": [
                {
                  "id": "resend_api_key",
                  "mechanics": {
                    "source": "cli",
                    "command": "resend --api-key re_xxx ..."
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "http",
        "url": "smtp.resend.com",
        "slug": "resend-smtp",
