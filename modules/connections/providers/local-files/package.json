{
  "name": "@engenty/connections-local-files",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/plugin.js",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/src/plugin.js"
    },
    "./ui/plugin": {
      "types": "./ui/plugin.ts",
      "default": "./dist/ui/plugin.js"
    },
    "./ui/grant-local-folder": {
      "types": "./ui/lib/grant-local-folder.ts",
      "default": "./ui/lib/grant-local-folder.ts"
    },
    "./ui/local-files-bridge": {
      "types": "./ui/components/local-files-bridge.tsx",
      "default": "./ui/components/local-files-bridge.tsx"
    }
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "scripts": {
    "build": "tsup src/plugin.ts ui/plugin.ts --format esm --clean",
    "dev": "tsup src/plugin.ts ui/plugin.ts --format esm --watch",
    "test": "vitest run",
    "lint": "echo 'No lint yet'"
  },
  "dependencies": {
    "@engenty/api-client": "workspace:*",
    "@engenty/connections": "workspace:*",
    "@engenty/connections-sdk": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "sonner": "^2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
