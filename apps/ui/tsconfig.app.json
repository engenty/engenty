{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting.
       noUnusedLocals/noUnusedParameters stay OFF here on purpose: this
       project compiles dependency SOURCES (packages and modules resolve
       types to src), and those flags would re-lint every dependency file
       under rules its own gate does not enforce — two gates disagreeing
       about the same line. Unused-code enforcement is biome's job. */
    "strict": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@engenty/projects/ui/portal": ["../../modules/projects/ui/portal.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/plugins/pro"]
}
