{
  "name": "@engenty/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "bash ../../scripts/portless-dev.sh",
    "dev:app": "next dev --port ${ENGENTY_DOCS_PORT:-3002} --hostname 127.0.0.1 --webpack",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "clean": "rm -rf .next dist node_modules public/_pagefind",
    "kill": "kill -9 $(lsof -t -i:3002)"
  },
  "portless": {
    "name": "docs.engenty",
    "script": "dev:app",
    "appPort": 3002
  },
  "dependencies": {
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-twoslash": "^3.2.0",
    "fumadocs-ui": "16.10.5",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.15.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "twoslash": "^0.3.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@engenty/environment": "workspace:*",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
