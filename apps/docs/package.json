{
  "name": "@engenty/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "bash ../../scripts/portless-dev.sh",
    "dev:app": "next dev --port ${ENGENTY_DOCS_PORT:-3002} --hostname 127.0.0.1 --webpack",
    "dev:portless": "pnpm run dev:app",
    "start": "next start",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "clean": "rm -rf .next dist node_modules public/_pagefind",
    "kill": "kill -9 $(lsof -t -i:3002)"
  },
  "portless": {
    "name": "docs.engenty",
    "script": "dev:app",
    "appPort": 3002
  },
  "dependencies": {
    "fumadocs-core": "16.15.11",
    "fumadocs-mdx": "15.4.1",
    "fumadocs-twoslash": "^3.3.1",
    "fumadocs-ui": "16.15.11",
    "lucide-react": "^1.46.0",
    "mermaid": "^11.17.2",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "twoslash": "^0.3.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@engenty/environment": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
