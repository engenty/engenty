{
  "name": "@engenty/ai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "portless": {
    "name": "ai.engenty",
    "script": "dev:app",
    "appPort": 8790
  },
  "scripts": {
    "dev": "bash ../../scripts/portless-dev.sh",
    "dev:app": "tsx watch --clear-screen=false src/index.ts",
    "dev:portless": "pnpm run dev:app",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts src/cli/mastra-schema-init.ts --format esm --clean --sourcemap --external @engenty/engenty-remote --external @engenty/ai-skills",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec biome check .",
    "studio": "MASTRA_AUTO_DETECT_URL=true MASTRA_STUDIO_BASE_PATH=/studio mastra studio --server-host 127.0.0.1 --server-port ${ENGENTY_AI_PORT:-8790} --server-api-prefix /ai --port ${ENGENTY_STUDIO_PORT:-43111}",
    "db:mastra-init": "tsx src/cli/mastra-schema-init.ts"
  },
  "dependencies": {
    "@11ty/gray-matter": "^2.1.0",
    "@ai-sdk/openai": "^4.0.67",
    "@chat-adapter/slack": "4.40.0",
    "@chat-adapter/telegram": "4.40.0",
    "@engenty/a2ui-catalog": "workspace:*",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-skills": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/context-graph": "workspace:*",
    "@engenty/doc-converter": "workspace:*",
    "@engenty/engenty-copilot": "workspace:*",
    "@engenty/engenty-specialists": "workspace:*",
    "@engenty/environment": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/import": "workspace:*",
    "@engenty/mcp-server": "workspace:*",
    "@engenty/notifications": "workspace:*",
    "@engenty/platform-settings": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/queue": "workspace:*",
    "@engenty/retrieval": "workspace:*",
    "@engenty/search-index": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/tenant-settings": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@mastra/agent-browser": "0.5.3",
    "@mastra/client-js": "1.46.0",
    "@mastra/core": "1.67.0",
    "@mastra/docker": "0.8.0",
    "@mastra/editor": "^0.15.0",
    "@mastra/files-sdk": "^0.3.1",
    "@mastra/hono": "1.7.9",
    "@mastra/langfuse": "1.5.7",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "1.17.8",
    "@mastra/otel-exporter": "1.3.16",
    "@mastra/pg": "1.25.0",
    "@mastra/server": "1.67.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "7.0.102",
    "croner": "^10.0.1",
    "files-sdk": "^1.9.0",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "pg": "8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "@engenty/engenty-remote": "workspace:*"
  },
  "devDependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/mastra": "1.1.4",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "mastra": "1.30.0",
    "rxjs": "7.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
