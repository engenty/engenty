{
  "name": "@engenty/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "portless": {
    "name": "engenty",
    "script": "api:app",
    "appPort": 8787
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cli": {
      "types": "./src/cli.ts",
      "default": "./dist/cli.js"
    },
    "./infra": {
      "types": "./src/infra/index.ts",
      "default": "./dist/infra/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/api-entry.ts src/infra/index.ts --format esm --clean --external pdfjs-dist --external sharp --external @napi-rs/canvas --external @engenty/entitlements --external @engenty/ai-skills",
    "api": "bash ../../scripts/portless-dev.sh",
    "api:app": "ENV=development ENGENTY_DEV_GATEWAY=1 ENGENTY_CORE_PORT=${ENGENTY_CORE_PORT:-8787} tsx watch --clear-screen=false --exclude \"**/node_modules/**\" --exclude \"**/.git/**\" --exclude \"**/.turbo/**\" --exclude \"**/coverage/**\" --exclude \"../../packages/**/dist/**\" --exclude \"../../modules/**/dist/**\" src/api-entry.ts",
    "dev:portless": "pnpm run api:app",
    "cli:dev": "tsx watch src/index.ts",
    "api:start": "node dist/api-entry.js",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint yet'"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/ai-skills": "workspace:*",
    "@engenty/api-contracts": "workspace:*",
    "@engenty/approvals-sdk": "workspace:*",
    "@engenty/cli": "workspace:*",
    "@engenty/dashboard-core": "workspace:*",
    "@engenty/doc-converter": "workspace:*",
    "@engenty/environment": "workspace:*",
    "@engenty/feature-flags": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/generative-ui": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/mcp-server": "workspace:*",
    "@engenty/notifications": "workspace:*",
    "@engenty/platform-settings": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/queue": "workspace:*",
    "@engenty/retrieval": "workspace:*",
    "@engenty/search-index": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/tenant-settings": "workspace:*",
    "@engenty/user-settings": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@napi-rs/canvas": "^1.0.9",
    "@scalar/hono-api-reference": "^0.11.4",
    "@supabase/supabase-js": "^2.116.0",
    "commander": "^15.0.0",
    "evlog": "^2.29.0",
    "hono": "^4.13.8",
    "jiti": "^2.7.0",
    "jose": "^6.2.12",
    "pdfjs-dist": "^5.7.284",
    "sharp": "^0.35.4",
    "sql.js": "^1.14.2",
    "uuidv7": "^1.2.1",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "@engenty/entitlements": "workspace:*"
  },
  "engenty": {
    "migrationsDir": "./supabase/migrations"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
