{
  "name": "@engenty/www",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:app": "vite --host",
    "dev:portless": "pnpm run dev:app",
    "dev:portless:ready": "node ../../scripts/dev-portless-ready.mjs --turbo-pane",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "biome check .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "portless": {
    "name": "www.engenty",
    "script": "dev:app",
    "appPort": 3003
  },
  "dependencies": {
    "@engenty/ui-core": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
