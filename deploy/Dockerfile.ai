# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

FROM base AS deps
# scripts/ is needed by the root postinstall hook; the build warm-up it does is
# redundant here (turbo builds below), so skip it.
ENV ENGENTY_SKIP_INSTALL_BUILD=1
# `pnpm fetch` resolves + downloads every dependency into the local store using
# ONLY the lockfile (no package.json/source needed), so this layer stays cached
# across ANY source change and only busts when pnpm-lock.yaml changes. Without
# this split, copying full source before `pnpm install` invalidated the install
# layer on every commit, forcing a full network re-resolve each build.
COPY pnpm-lock.yaml ./
RUN pnpm fetch
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY scripts ./scripts
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules
RUN pnpm install --frozen-lockfile --offline

FROM deps AS build
# Lower on memory-constrained builders (each parallel tsup/tsc worker is heavy).
ARG TURBO_BUILD_CONCURRENCY=10
# @engenty/ai plus all modules (the AI runtime loads module plugins whose
# dists must exist); '...' dependents would drag in the whole UI build.
RUN pnpm exec turbo run build --concurrency=$TURBO_BUILD_CONCURRENCY --filter=@engenty/ai --filter='./modules/*'

FROM node:24-bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/ai/package.json ./apps/ai/
COPY --from=deps /app/node_modules ./node_modules
# pnpm links workspace deps inside the importer's own node_modules
# (apps/ai/node_modules/@engenty/* -> ../../../packages/...), so ship both
# that link dir and the packages/ + modules/ trees (with dist) it points into.
COPY --from=deps /app/apps/ai/node_modules ./apps/ai/node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/modules ./modules
COPY --from=build /app/apps/ai/dist ./apps/ai/dist

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8790
ENV ENGENTY_CORE_BASE_URL=http://engenty-edge:8787

EXPOSE 8790
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8790/ai/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/ai/dist/index.js"]
