# syntax=docker/dockerfile:1-labs
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

FROM base AS deps
# The postinstall build warm-up is redundant here (turbo builds below).
ENV ENGENTY_SKIP_INSTALL_BUILD=1
# `pnpm fetch` resolves + downloads every dependency into the local store using
# ONLY the lockfile (no package.json/source needed), so this layer stays cached
# across ANY source change and only busts when pnpm-lock.yaml changes.
COPY pnpm-lock.yaml ./
# The lockfile records a patched dependency, so `pnpm fetch` resolves the patch
# and dies with ERR_PNPM_PATCH_NOT_FOUND unless patches/ is already present.
# This is what broke every deploy image from v0.1.75 onward.
COPY patches ./patches
RUN pnpm fetch
# Manifests ONLY above the install — never source.
#
# `pnpm install` produces the ~3.7 GB node_modules that dominates this image
# (~1 GB compressed; everything that actually changes per release is under
# 90 MB). BuildKit gives that COPY a fresh digest whenever the layer is
# rebuilt, so ANY per-commit input landing above it means production
# re-downloads the whole gigabyte on every release — and Coolify pulls AFTER
# removing the old containers, so that download happens with the site already
# down. Measured on v0.1.107: 188s of a 239s outage.
#
# --parents keeps each manifest at its own workspace path (hence the -labs
# frontend). The providers glob is a real workspace root — see pnpm-workspace.yaml.
COPY package.json pnpm-workspace.yaml ./
COPY --parents \
  apps/*/package.json \
  packages/*/package.json \
  modules/*/package.json \
  modules/*/providers/*/package.json \
  ./
# The root postinstall hook imports scripts/lib at module scope even though
# ENGENTY_SKIP_INSTALL_BUILD short-circuits it, so scripts/ must exist. It
# changes rarely; when it does we pay one extra full pull. That is the price of
# not passing --ignore-scripts, which would also skip dependencies' own native
# build scripts.
COPY scripts ./scripts
# @engenty/docs is the one workspace with an install hook (fumadocs-mdx), and it
# codegens from apps/docs/source.config.ts — source this stage deliberately does
# not have. None of the deploy images build docs, so exclude the workspace
# rather than drag its source above the install and re-break the caching this
# reorder exists to fix. Excluding it also keeps its deps out of the store.
RUN pnpm install --frozen-lockfile --offline --filter='!@engenty/docs'

FROM deps AS build
# Lower on memory-constrained builders (each parallel tsup/tsc worker is heavy).
ARG TURBO_BUILD_CONCURRENCY=10
# @engenty/ai plus all modules (the AI runtime loads module plugins whose
# dists must exist); '...' dependents would drag in the whole UI build.
COPY turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules
RUN pnpm exec turbo run build --concurrency=$TURBO_BUILD_CONCURRENCY --filter=@engenty/ai --filter='./modules/*'

FROM node:24-bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/ai/package.json ./apps/ai/
COPY --from=deps /app/node_modules ./node_modules
# pnpm links workspace deps inside the importer's own node_modules
# (apps/ai/node_modules/@engenty/* -> ../../../packages/...), so ship both
# that link dir and the packages/ + modules/ trees (with dist) it points into.
COPY --from=deps /app/apps/ai/node_modules ./apps/ai/node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/modules ./modules
COPY --from=build /app/apps/ai/dist ./apps/ai/dist

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8790
ENV ENGENTY_CORE_BASE_URL=http://engenty-edge:8787

EXPOSE 8790
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8790/ai/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/ai/dist/index.js"]
