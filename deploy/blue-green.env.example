# Install as /etc/engenty/blue-green.env on the Coolify host (mode 600).
# Values stay server-side; the forced SSH command accepts only a release tag.
BLUE_APP_UUID=replace-with-blue-coolify-app-uuid
GREEN_APP_UUID=replace-with-green-coolify-app-uuid
BACKEND_APP_UUID=replace-with-stable-backend-app-uuid

# Each color has a permanent direct health domain. Both edge apps also carry
# PUBLIC_APP_URL as a production domain; the inactive application stays stopped.
BLUE_HEALTH_URL=https://engenty-blue.example.com
GREEN_HEALTH_URL=https://engenty-green.example.com
PUBLIC_APP_URL=https://app.example.com

COOLIFY_URL=https://coolify.example.com
COOLIFY_API_TOKEN_FILE=/etc/engenty/coolify-api-token

# Docker --env-file containing SUPABASE_DB_URL for the one-shot migrate image.
MIGRATION_ENV_FILE=/etc/engenty/migration.env
