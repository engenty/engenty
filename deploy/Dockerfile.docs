# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

FROM base AS deps
# scripts/ is needed by the root postinstall hook; skip its build warm-up.
ENV ENGENTY_SKIP_INSTALL_BUILD=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY scripts ./scripts
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules
COPY docs/content ./docs/content
RUN pnpm install --frozen-lockfile

FROM deps AS build
RUN pnpm exec turbo run build --filter=@engenty/docs

FROM node:24-bookworm-slim AS runtime
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app/apps/docs

COPY --from=deps /app/node_modules /app/node_modules
COPY --from=build /app/apps/docs/.next ./.next
COPY --from=build /app/apps/docs/public ./public
COPY --from=build /app/apps/docs/package.json ./package.json
COPY --from=deps /app/docs/content /app/docs/content

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000
CMD ["pnpm", "exec", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
