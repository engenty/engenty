# syntax=docker/dockerfile:1-labs
#
# apps/app-host — runtime for tenant-authored engenty Apps.
#
# Unlike every other service here, this one supervises TWO native child
# processes that ship as platform packages inside node_modules:
#   - @rivetkit/engine-cli-<platform>/rivet-engine   (the Rivet Engine)
#   - @rivet-dev/agentos-sidecar-<platform>          (the agentOS sidecar)
# RivetKit spawns both from registry.start(); there is no separate engine
# deployment. Two consequences the other Dockerfiles do not have:
#   1. the image MUST be built for its target architecture, because pnpm
#      resolves those optional platform packages for the BUILD platform;
#   2. ~/.rivetkit holds the engine's durable store and must be a volume, or
#      every restart loses the deployed releases.
#
# This service publishes NO port and is NOT a gateway target. It runs tenant
# code, so it deliberately has no origin of its own — see PLAN-engenty-apps.md
# §2.3.
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

# `pnpm release` bumps `version` in the ROOT package.json on every single
# release, and the deps stage below copies that file — so the ~3.7 GB install
# layer was invalidated by the release process itself, forever. v0.1.108 moved
# the install above the source copy and still re-pulled ~1 GB on v0.1.109
# (`RUN pnpm install` executed, ~614s for ai) for exactly this reason.
#
# Normalise the version here and copy the RESULT into deps: BuildKit keys
# `COPY --from` on the CONTENT of the copied path, so deps sees a byte-identical
# manifest across releases and stays cached. This stage re-runs every release
# and costs nothing. The real version is restored in the runtime stage.
FROM base AS manifests
COPY package.json ./package.json
RUN sed -i 's/"version": *"[^"]*"/"version": "0.0.0-cache"/' ./package.json

FROM base AS deps
ENV ENGENTY_SKIP_INSTALL_BUILD=1
COPY pnpm-lock.yaml ./
# patches/ carries the @rivet-dev/agentos-apps patch: the build-VM output
# mount fix without which deployApp() cannot succeed, and the per-App VM
# options (/data mount, guest identity). It must be copied BEFORE `pnpm fetch`,
# not after: the lockfile records the patch, so fetch resolves it and fails
# with ERR_PNPM_PATCH_NOT_FOUND if the file is not there yet. This ordering
# broke every deploy image build from v0.1.75 onward.
COPY patches ./patches
RUN pnpm fetch
# Manifests ONLY above the install — never source.
#
# `pnpm install` produces the ~3.7 GB node_modules that dominates this image
# (~1 GB compressed; everything that actually changes per release is under
# 90 MB). BuildKit gives that COPY a fresh digest whenever the layer is
# rebuilt, so ANY per-commit input landing above it means production
# re-downloads the whole gigabyte on every release — and Coolify pulls AFTER
# removing the old containers, so that download happens with the site already
# down. Measured on v0.1.107: 188s of a 239s outage.
#
# --parents keeps each manifest at its own workspace path (hence the -labs
# frontend). The providers glob is a real workspace root — see pnpm-workspace.yaml.
COPY --from=manifests /app/package.json ./package.json
COPY pnpm-workspace.yaml ./
COPY --parents \
  apps/*/package.json \
  packages/*/package.json \
  modules/*/package.json \
  modules/*/providers/*/package.json \
  ./
# The root postinstall hook imports scripts/lib at module scope even though
# ENGENTY_SKIP_INSTALL_BUILD short-circuits it, so scripts/ must exist. It
# changes rarely; when it does we pay one extra full pull. That is the price of
# not passing --ignore-scripts, which would also skip dependencies' own native
# build scripts.
COPY scripts ./scripts
# @engenty/docs is the one workspace with an install hook (fumadocs-mdx), and it
# codegens from apps/docs/source.config.ts — source this stage deliberately does
# not have. None of the deploy images build docs, so exclude the workspace
# rather than drag its source above the install and re-break the caching this
# reorder exists to fix. Excluding it also keeps its deps out of the store.
RUN pnpm install --frozen-lockfile --offline --filter='!@engenty/docs'

FROM deps AS build
ARG TURBO_BUILD_CONCURRENCY=4
COPY turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules
RUN pnpm exec turbo run build --concurrency=$TURBO_BUILD_CONCURRENCY --filter=@engenty/app-host

FROM node:24-bookworm-slim AS runtime
# git: every App's source is a repository on the spaces tree, written and read
# by this service.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
# pnpm links workspace deps inside the importer's own node_modules, so ship
# that link dir and the packages/ tree it points into.
COPY --from=deps /app/apps/app-host/node_modules ./apps/app-host/node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/app-host/dist ./apps/app-host/dist

# Fail the build rather than the first deploy if the patch did not survive
# install, and prove both native binaries are present and executable.
# Resolved from the filesystem, not `require.resolve`: agentos-apps declares no
# `main` and its `exports` map defines only an `import` condition, so a CJS
# resolve throws ERR_PACKAGE_PATH_NOT_EXPORTED whether or not the patch applied.
# The guard could never pass — it just never ran, because `pnpm fetch` failed
# first.
RUN PKG="$(readlink -f /app/apps/app-host/node_modules/@rivet-dev/agentos-apps)" \
  && test -n "$PKG" && test -d "$PKG" \
  && grep -rq 'engenty patch (2026-07-25)' "$PKG" \
  && grep -rq 'engenty patch (2026-09-09)' "$PKG" \
  && echo "agentos-apps patch present: $PKG" \
  || (echo "agentos-apps patch missing — deployApp() would fail at runtime" && exit 1)
RUN ENGINE="$(find /app/node_modules/.pnpm -type f -name rivet-engine | head -1)" \
  && test -n "$ENGINE" && test -x "$ENGINE" \
  && echo "rivet-engine present: $ENGINE" \
  || (echo "rivet-engine binary missing — this image must be built for its target architecture" && exit 1)
RUN SIDECAR="$(find /app/node_modules/.pnpm -type f -name agentos-sidecar | head -1)" \
  && test -n "$SIDECAR" && test -x "$SIDECAR" \
  && echo "agentos-sidecar present: $SIDECAR" \
  || (echo "agentos-sidecar binary missing — this image must be built for its target architecture" && exit 1)

# Root package.json changes every release (the version bump), so it MUST land
# BELOW the multi-gigabyte node_modules copies above. A changed layer forces
# every later layer in the stage to be rebuilt, and a rebuilt layer gets a
# fresh digest — which is production re-downloading the whole image. Keeping
# it last is what lets the big layers stay byte-identical between releases.
# The real version also matters here: prod is verified with
# `docker exec ... head -3 /app/package.json`.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/app-host/package.json ./apps/app-host/

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV ENGENTY_APP_HOST_PORT=8795
# RivetKit keeps its durable engine store under $HOME/.rivetkit. Point HOME at
# the mounted volume, or every restart drops all deployed app releases.
ENV HOME=/data
# uid 1000 is the space computer's `sandbox` user. Both containers write the
# same App directories on /opt/engenty/spaces (source and /data), so they must
# be the same uid — files one creates the other must edit. Existing volumes
# created by an earlier, root-running image need a one-time chown (DEPLOY.md).
RUN mkdir -p /data && chown 1000:1000 /data
USER 1000:1000

# Deliberately no EXPOSE: nothing outside the internal engenty network may
# reach this service.
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8795/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/app-host/dist/index.js"]
