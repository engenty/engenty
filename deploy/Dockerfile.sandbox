# syntax=docker/dockerfile:1
#
# Unified, lean sandbox runtime for the Engenty agent sandbox (`engenty-sandbox`).
#
# Mastra `@mastra/docker` `DockerSandbox` runs every command as
# `sh -c "<command>"` and keeps the container alive with `sleep infinity`, so the
# image only strictly needs `/bin/sh` + `sleep`. We prebake a small, universal
# runtime so no per-run install is needed for the common case.
#
# Both JS runtimes ship on purpose. A model writing JavaScript reaches for
# `node`/`npm` first — that is what its training data is full of — and an image
# without them turns every such script into a retry. `bun` is kept because Code
# Mode's runner spawns it and because it runs TypeScript with no build step.
#   - node + npm/npx  → the runtime a model assumes by default
#   - bun             → TypeScript with no build step; Code Mode's runner
#   - python3         → from the base image
#   - uv              → fast Python package manager
#   - jq              → the shell tool models reach for on JSON
# Base is `python:3.12-slim`: it already provides python3 + sh + coreutils on a
# small Debian footprint, and Node is layered on from the official image rather
# than apt so the version is pinned and current.
ARG NODE_IMAGE=node:24-bookworm-slim

FROM ${NODE_IMAGE} AS node-runtime

FROM python:3.12-slim

# Pin the runtimes for reproducible images. Bump deliberately.
ARG BUN_VERSION=1.2.21

# Minimal, broadly-needed tooling. ca-certificates/curl are required to fetch the
# bun installer and for TLS at runtime; unzip is required by the bun installer to
# unpack its release archive; git is small and very commonly needed by agent code;
# jq is what a model writes when it post-processes JSON in shell.
# Clean apt lists in the same layer to keep the image lean.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    unzip \
  && rm -rf /var/lib/apt/lists/*

# node: copied from the official image rather than installed via apt (Debian's
# nodejs is years behind). npm and corepack live in node_modules and are linked
# onto PATH the same way the official image does it.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && ln -sf /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

# uv: standalone fast Python package manager (used for prebaked + per-run installs).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# bun: official installer, then relocate the binary to a system PATH location so
# every command (sh -c, any user) can resolve `bun` without per-shell env setup.
ENV BUN_INSTALL=/usr/local
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
  && ln -sf /usr/local/bin/bun /usr/local/bin/bunx

# Prebaked universal Python libs. Keep this list SMALL on purpose — only truly
# universal HTTP clients. `--system` installs into the image's site-packages.
RUN uv pip install --system --no-cache httpx requests

# Prebaked universal JS lib: zod, for both runtimes. Two installs because the
# two resolvers do not share a global root, and a model that writes
# `import "zod"` should not have to know which runtime it landed on.
#
# `NODE_PATH` is what makes the npm half actually usable: node does NOT look in
# the global root on its own, so without this `require("zod")` fails in a script
# run from /sandbox while the identical bun line works — the exact
# runtime-dependent surprise the two installs exist to remove.
ENV NODE_PATH=/usr/local/lib/node_modules
RUN bun add -g zod \
  && npm install -g zod

# The sandbox runs as an unprivileged user. Its OS home is NOT /home: that path
# is the agent's own home mount, bound in at run time, and an OS home there
# would be shadowed by the bind.
#
# `/cache` holds the per-space package caches the host binds in (uv, bun, npm),
# so a second `pip install` in the same space is a cache hit rather than a
# download. The host sets each tool's cache variable when it makes the bind —
# one source of truth for a path and the variable that points at it — so this
# only has to make the mount points exist and be writable.
ENV HOME=/opt/sandbox
RUN useradd --create-home --home-dir /opt/sandbox --uid 1000 sandbox \
  && mkdir -p /sandbox /cache/bun /cache/npm /cache/uv \
  && chown -R sandbox:sandbox /sandbox /cache /opt/sandbox
# A space's Apps are git work trees bound in at /sandbox/apps/<slug>/src, shared
# with app-host. Commits made here need an identity, and a tree whose owner the
# container runtime maps differently must not stop git with "dubious ownership".
RUN git config --system user.name "engenty agent" \
  && git config --system user.email "agent@engenty.local" \
  && git config --system --add safe.directory '*'

# No browser here. A CLI that opens one to sign in gets this instead: the URL
# is printed to stderr for the agent to hand to the person (browser_sign_in),
# and the CLI keeps waiting for its callback. `BROWSER` covers Python's
# webbrowser and the xdg-open scripts CLIs bundle; the xdg-open on PATH covers
# the rest.
RUN printf '#!/bin/sh\necho "Open this URL to continue: $1" >&2\n' > /usr/local/bin/engenty-open \
  && chmod 755 /usr/local/bin/engenty-open \
  && ln -sf /usr/local/bin/engenty-open /usr/local/bin/xdg-open
ENV BROWSER=/usr/local/bin/engenty-open

# `engenty tools list|schema|call` from bash: a client of the relay apps/ai
# starts in each container (apps/ai/src/ai/sandbox/engenty-cli-relay.ts). No
# token and no network needed — every command the agent runs carries a ticket.
COPY --chmod=755 deploy/sandbox/engenty.mjs /usr/local/bin/engenty

USER sandbox

# DockerSandbox overrides workingDir to /sandbox at runtime; set it for parity.
WORKDIR /sandbox
