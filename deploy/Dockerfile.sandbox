# syntax=docker/dockerfile:1
#
# Unified, lean sandbox runtime for the Engenty agent sandbox (`engenty-sandbox`).
#
# Mastra `@mastra/docker` `DockerSandbox` runs every command as
# `sh -c "<command>"` and keeps the container alive with `sleep infinity`, so the
# image only strictly needs `/bin/sh` + `sleep`. We prebake a small, universal
# runtime so no per-run install is needed for the common case:
#   - bun     → runs TypeScript natively (`bun run file.ts`, no tsx/Node needed)
#   - python3 → from the base image
#   - uv      → fast Python package manager
# Base is `python:3.12-slim`: it already provides python3 + sh + coreutils on a
# small Debian footprint, which is leaner than layering python onto a node image
# (we don't ship Node at all — bun covers JS/TS).
FROM python:3.12-slim

# Pin bun for reproducible images. Bump deliberately.
ARG BUN_VERSION=1.2.21

# Minimal, broadly-needed tooling. ca-certificates/curl are required to fetch the
# bun installer and for TLS at runtime; unzip is required by the bun installer to
# unpack its release archive; git is small and very commonly needed by agent code.
# Clean apt lists in the same layer to keep the image lean.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    unzip \
  && rm -rf /var/lib/apt/lists/*

# uv: standalone fast Python package manager (used for prebaked + per-run installs).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# bun: official installer, then relocate the binary to a system PATH location so
# every command (sh -c, any user) can resolve `bun` without per-shell env setup.
ENV BUN_INSTALL=/usr/local
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
  && ln -sf /usr/local/bin/bun /usr/local/bin/bunx

# Prebaked universal Python libs. Keep this list SMALL on purpose — only truly
# universal HTTP clients. `--system` installs into the image's site-packages.
RUN uv pip install --system --no-cache httpx requests

# Prebaked universal JS/TS lib: zod, installed globally and linked so `bun run`
# / `import "zod"` resolves without a per-project install.
RUN bun add -g zod

# DockerSandbox overrides workingDir to /sandbox at runtime; set it for parity.
WORKDIR /sandbox
