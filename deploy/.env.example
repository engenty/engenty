# Generated by `engenty env example` from packages/cli/src/env-setup/env-manifest.ts.
# Edit the manifest, then run: pnpm env:example:write — do not edit this file by hand.
# Interactive setup: pnpm engenty env init

# Copy to deploy/.env and set values before:
# docker compose -f deploy/docker-compose.yaml --env-file deploy/.env up -d
# Full guide: deploy/DEPLOY.md

# ── API security ──

# API JWT signing secret (device login, CLI, service tokens). Generate: engenty env generate.
ENGENTY_SECURITY_JWT_SECRET=

# Private key the tenant-locked server lane signs its engenty_server JWTs with, as a PKCS8 PEM or that PEM base64-encoded. Set this ONLY when the Supabase project verifies asymmetric keys — Supabase Cloud after the JWT-signing-keys migration publishes a JWKS and keeps its own private key, so there is no shared secret to sign with and HS256 tokens are rejected outright. Generate an EC P-256 key, import it into the project's JWT signing keys, and keep the private half here. Leave unset on local/self-hosted stacks, which still verify the symmetric secret. Must be set together with ENGENTY_SERVER_LANE_KEY_ID.
# ENGENTY_SERVER_LANE_PRIVATE_KEY=

# Key id (`kid`) of the imported signing key above — the project's JWKS holds several keys and the verifier needs to know which one to try. Supabase requires this to be a UUID and rejects the import otherwise, so generate one (`uuidgen`) and use the same value in the imported JWK and here. Must be set together with ENGENTY_SERVER_LANE_PRIVATE_KEY; setting one without the other fails at boot rather than silently falling back to HS256.
# ENGENTY_SERVER_LANE_KEY_ID=208398c6-7a4c-467e-b222-8f9f6e45a0dc

# Canonical HTTPS URL of the Engenty MCP resource server (ends with /mcp). OAuth access tokens must carry this exact audience; the generic `aud: engenty` token is never accepted at /mcp.
# ENGENTY_MCP_RESOURCE_URL=https://engenty.localhost/mcp

# MCP access-token audience. Defaults to `engenty-mcp`. Must match the claim minted by core.custom_access_token_hook; generic `aud: engenty` tokens are never accepted at /mcp.
# ENGENTY_MCP_AUDIENCE=engenty-mcp

# The service credential for apps/ai (scheduler, task dispatcher, remote channels), as `<credentialId>.<secret>`. Locally `engenty setup` mints and rewrites it whenever the row is missing from the local Supabase (a `db reset` drops it) — `engenty service-token ensure-local` does the same by hand. On a deployment: `engenty service-token create --name ai-service` after a device-flow `engenty auth login` (not --dev). A locked-down mint must list module.read,module.write,module.execute plus Plan caps (module.tasks.read,module.tasks.write) — module.read does not cover module.tasks.read. apps/ai exchanges it at POST /api/auth/service-token for a 15-minute engenty token per tenant — no Supabase user, revocable with `engenty service-token revoke`, capabilities clamped at creation.
#   Local: pnpm engenty setup (or: pnpm engenty service-token ensure-local)
#   Deployment: pnpm engenty service-token create --name ai-service
# ENGENTY_AI_SERVICE_SECRET=

# ── Supabase ──

# Supabase API endpoint. Local: written by `engenty env init` from `supabase status`. Production: project URL reachable from the Docker network.
SUPABASE_URL=

# Supabase secret key (server-side admin access — never expose to the browser). Local: from pnpm supabase → Secret (Authentication Keys).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Supabase anon/publishable key (public browser key). Production only — locally the UI reads VITE_SUPABASE_ANON_KEY from the root .env.local.
SUPABASE_ANON_KEY=

# Direct Postgres connection string. Two uses: (1) apps/ai Mastra framework storage (workflow/run snapshots, native suspend/resume — without it Mastra falls back to in-memory); (2) the deploy migrate init-service applies pending migrations to it on each deploy. The service-role key can't run DDL, so this is REQUIRED for automatic migrations (unset ⇒ the migrate step is skipped and you apply migrations manually). Local: written by `engenty env init` from `supabase status`.
# SUPABASE_DB_URL=

# JWT secret the Supabase stack verifies HS256 tokens with. The tenant-locked server lane (core and apps/ai) signs its engenty_server tokens with it; without it the lane falls back to ENGENTY_SECURITY_JWT_SECRET, which the stack does not know, and every tenant-lane query fails with "No suitable key or wrong key type". Local: written by `engenty env init` from `supabase status` (JWT_SECRET). Self-hosted: the stack's JWT_SECRET. Supabase Cloud with asymmetric signing keys: leave unset and use ENGENTY_SERVER_LANE_PRIVATE_KEY instead.
# SUPABASE_JWT_SECRET=

# Supabase API endpoint for the UI. Required locally, where Vite serves the SPA and reads this from the workspace root. In a deployment the gateway writes it into the served page and falls back to SUPABASE_URL — set it there only when the browser-facing address differs, e.g. SUPABASE_URL is container-internal Docker DNS.
# VITE_SUPABASE_URL=

# Supabase anon/publishable key for the UI (public browser key). Local: from pnpm supabase. In a deployment the gateway writes it into the served page and falls back to SUPABASE_ANON_KEY, so it is only needed when the two differ.
# VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Core API & AI workspace ──

# Days a marked-deleted space stays recoverable before the background sweep hard-deletes it and its data. Defaults to 7. Set to 0 to purge on the next sweep.
# ENGENTY_SPACE_PURGE_AFTER_DAYS=7

# TypeSafe (Jev) API key for the small classifiers and the browser fast loop — optional: without it Jev is reached through the Vercel AI Gateway (typesafe-ai/jev) on AI_GATEWAY_API_KEY.
# https://docs.typesafe.ai/introduction/quickstart
#   1. Sign in at https://typesafe.ai and create an API key
#   2. Copy it here
# TYPESAFE_API_KEY=

# ── engenty Apps ──

# Internal URL of apps/app-host (apps/ai → app-host). Never published and never a gateway target — app-host runs tenant-authored code, so it gets no origin of its own.
# ENGENTY_APP_HOST_URL=http://127.0.0.1:8795

# Shared secret apps/ai presents on every app-host internal call. Required in production — app-host refuses to boot without it.
# ENGENTY_APP_HOST_TOKEN=generate-a-random-64-char-secret

# Root of the spaces tree, shared by app-host and engenty-ai: every App's source repository and /data directory live under tenants/<tenant>/spaces/<space>/apps/<slug>. app-host commits and deploys from it and mounts data/ at /data inside the App's isolate; engenty-ai binds a space's apps/ into that space's computer at /sandbox/apps. Defaults to ~/.engenty/spaces; the compose files bind /opt/engenty/spaces.
# ENGENTY_SPACES_DIR=/opt/engenty/spaces

# Deployment-wide kill switch for engenty Apps. Set to false and the module registers no operations at all — nothing to reach. Per-tenant gating is module licensing; per-app gating is app_archive.
# ENGENTY_APPS_ENABLED=true

# ── Production edge ──

# Public URL, single origin — Coolify Traefik should point HTTPS here → engenty-edge:8787. No trailing slash.
PUBLIC_APP_URL=https://app.example.com

# Port published on the host when not using Coolify routing only (optional).
# EDGE_PUBLISH_PORT=8787

# Immutable edge image tag used by the blue/green edge Compose file.
# ENGENTY_RELEASE_TAG=v0.1.127

# Immutable image tag used by the stable blue/green backend Compose file.
# ENGENTY_BACKEND_RELEASE_TAG=v0.1.127

# Blue/green edge color for this Coolify application (blue or green).
# ENGENTY_DEPLOY_COLOR=blue

# CORS for apps/ai (comma-separated origins allowed to call /ai). Defaults to PUBLIC_APP_URL, which is the whole list for a single-origin install — set it only to allow additional origins.
# ENGENTY_CORS_ORIGINS=https://app.example.com

# ── Production gateway flags ──

# Proxy /docs to the docs service (compose profile docs).
# ENGENTY_GATEWAY_DOCS_ENABLED=false

# Proxy /studio to Mastra Studio (compose profile studio).
# ENGENTY_GATEWAY_STUDIO_ENABLED=false

# HTTP basic auth on /studio (user:password).
# ENGENTY_GATEWAY_STUDIO_BASIC_AUTH=operator:change-me

# ── Agent sandbox (Docker-only) ──

# Prebaked agent sandbox runtime image (bun + python3 + uv). Build first: docker compose -f deploy/docker-compose.yaml build.
# ENGENTY_SANDBOX_DOCKER_IMAGE=engenty-sandbox:latest

# Host dir for sandbox staging; mirrored 1:1 into containers (see compose notes).
# ENGENTY_SANDBOX_HOST_DIR=/opt/engenty/sandboxes

# ── User browsers (one per person per Space) ──

# Idle browsers are stopped after this many ms (logins survive in the profile). Default 15 min.
# ENGENTY_BROWSER_IDLE_STOP_MS=900000

# Running browsers per tenant, host-wide. Over the ceiling, Start answers 429. Default 4.
# ENGENTY_BROWSER_MAX_PER_TENANT=4

# Running browsers per person, host-wide. Over the ceiling, Start answers 429. Default 2.
# ENGENTY_BROWSER_MAX_PER_USER=2

# Shared secret for the live-view tickets across engenty-ai instances (also used by the voice cascade). Random per process when unset, which only works while there is one instance.
# ENGENTY_REALTIME_TICKET_SECRET=

# Experimental: offer agents the browser_run_fast tool (TypeSafe Jev decides each browser step). Needs AI_GATEWAY_API_KEY or TYPESAFE_API_KEY.
# ENGENTY_BROWSER_FAST_LOOP=false

# Fast loop: a step is executed only when the classifier's pick leads the runner-up by at least this probability margin (0–1); otherwise the agent LLM takes over. Default 0.1.
# ENGENTY_BROWSER_FAST_MIN_MARGIN=0.1

# Fast loop: hard ceiling of browser steps per browser_run_fast call. Default 60.
# ENGENTY_BROWSER_FAST_MAX_STEPS=60

# ── Connections ──

# AES-256-GCM key for connection tokens at rest (32 bytes, base64). Generate: openssl rand -base64 32.
# CONNECTIONS_TOKEN_ENC_KEY=

# Override the OAuth callback URL when core is behind a public proxy. Default: <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
# CONNECTIONS_REDIRECT_URI=

# ── Connections — External ──

# Base URL of the integrations.sh-compatible registry used for connector discovery. Only contacted during admin import/refresh, never at agent runtime. Defaults to https://integrations.sh.
# ENGENTY_INTEGRATIONS_REGISTRY_URL=

# ── Connections — GitHub ──

# GitHub OAuth App client ID for the GitHub connector.
# https://github.com/settings/developers
#   1. Create an OAuth App at https://github.com/settings/developers → New OAuth App.
#   2. Set Authorization callback URL to: <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
#   3. Request scope 'repo' at connect time (configured by the connector).
#   4. Copy the Client ID from the app's General page.
# GITHUB_OAUTH_CLIENT_ID=

# GitHub OAuth App client secret for the GitHub connector.
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Connections — Google ──

# Google OAuth 2.0 client ID used by the Gmail, Drive, Calendar and Contacts connectors.
# https://console.cloud.google.com/apis/credentials
#   Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console → APIs & Services → Credentials.
#   Add the authorized redirect URI: <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
#   Enable the Gmail, Drive, Calendar and People APIs for the project.
# GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth 2.0 client secret for the same OAuth client as GOOGLE_OAUTH_CLIENT_ID.
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── Connections — Microsoft ──

# Application (client) ID of the Azure app registration used for the Microsoft Graph OAuth flow (tenant: common).
# https://portal.azure.com
#   1. Open the Azure Portal → App registrations and create a registration (supported account types: any org directory + personal Microsoft accounts).
#   2. Add the Web redirect URI <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
#   3. Under API permissions, add the delegated Microsoft Graph permissions: User.Read, Mail.Read, Mail.ReadWrite, Mail.Send, Calendars.Read, Calendars.ReadWrite, Files.Read, Files.ReadWrite.
#   4. Copy the Application (client) ID from the Overview page.
# MICROSOFT_OAUTH_CLIENT_ID=

# Client secret of the Azure app registration (Certificates & secrets → New client secret; copy the secret Value).
# MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Connections — Slack ──

# Slack OAuth v2 client ID for the Slack connector.
# https://api.slack.com/apps
#   1. Create an app at https://api.slack.com/apps (from scratch).
#   2. Under OAuth & Permissions → User Token Scopes add: channels:read, groups:read, channels:history, groups:history, search:read, chat:write, reactions:write, users:read.
#   3. Under OAuth & Permissions → Redirect URLs add: <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
#   4. Copy the Client ID from Basic Information → App Credentials.
# SLACK_OAUTH_CLIENT_ID=

# Slack OAuth v2 client secret for the Slack connector.
# SLACK_OAUTH_CLIENT_SECRET=

# ── AI ──

# Vercel AI Gateway API key — required for the copilot (apps/ai). Create at https://vercel.com/d?to=/[team]/~/ai/api-keys
# https://vercel.com/docs/ai-gateway
#   1. Open the Vercel dashboard → AI Gateway → API keys
#   2. Create a key and copy it
AI_GATEWAY_API_KEY=

# OpenRouter API key — optional second model gateway. Set it to bind roles to OpenRouter models in Settings → AI models; Vercel-bound roles keep using AI_GATEWAY_API_KEY.
# https://openrouter.ai/docs/api-reference/authentication
#   1. Open https://openrouter.ai/settings/keys
#   2. Create a key and copy it
# OPENROUTER_API_KEY=

# Enable apps/ai to refresh the Gateway model catalog from Vercel AI Gateway on a schedule.
# AI_GATEWAY_MODEL_SYNC_ENABLED=true

# Run Gateway model catalog sync when apps/ai starts (populates copilot model dropdowns after fresh setup).
# AI_GATEWAY_MODEL_SYNC_RUN_ON_START=true

# Opper API key — a third model gateway (OpenAI-compatible, EU-hosted). Chat models only; its catalog is listed once the key is set.
# https://docs.opper.ai
#   1. Open https://platform.opper.ai → API keys
#   2. Create a key and copy it
# OPPER_API_KEY=

# OpenAI API key — reaches OpenAI directly as a model gateway (chat models) and powers realtime voice.
# https://platform.openai.com/api-keys
#   Create a key under API keys in the OpenAI platform.
# OPENAI_API_KEY=

# Anthropic API key — reaches Anthropic directly as a model gateway (chat models).
# https://console.anthropic.com/settings/keys
#   Create a key under API keys in the Anthropic console.
# ANTHROPIC_API_KEY=

# Mistral API key — enables the Voxtral speech-to-text leg of the Voxtral+ElevenLabs realtime voice cascade. Without it the cascade provider is not registered and tenants selecting it get HTTP 501.
# https://console.mistral.ai/api-keys
#   Create a key under API Keys in the Mistral console.
# MISTRAL_API_KEY=

# ElevenLabs API key — enables the text-to-speech leg of the Voxtral+ElevenLabs realtime voice cascade (Austrian/Bavarian dialect voices). Required together with MISTRAL_API_KEY. The key must include voices_read and text_to_speech permissions.
# https://elevenlabs.io/app/settings/api-keys
#   Create a key under Profile → API Keys in the ElevenLabs app.
#   Enable at least voices_read and text_to_speech (restricted keys without voices_read cannot populate the voice dropdown).
# ELEVENLABS_API_KEY=

# Set to false to disable Mastra thread and shared observational memory for agent chat. Enabled by default.
# ENGENTY_AI_OBSERVATIONAL_MEMORY=

# Set to true to enable Mastra thread-scoped semantic recall (embeds every saved chat turn and queries pgvector on each turn). Off by default. Requires AI Gateway embeddings and a Postgres vector URL.
# ENGENTY_AI_SEMANTIC_RECALL=

# Time budget for ONE model call in an agent run, in milliseconds. Default 180000 (3 min); a call past it fails the run with a named timeout instead of hanging. 0 disables.
# ENGENTY_AI_STEP_TIMEOUT_MS=

# Hard override for the recalled-history token budget of every agent, in tokens. Unset: derived per run from the model's catalog context window minus the tool block, the reply reserve and the runtime tail (100000 when the window is unknown).
# ENGENTY_AI_HISTORY_TOKEN_LIMIT=

# Time budget for a WHOLE agent run (every step, tool call and retry), in milliseconds. Default 1200000 (20 min). 0 disables.
# ENGENTY_AI_RUN_TIMEOUT_MS=

# ── Observability ──

# Langfuse secret key. Sends every agent run (model steps, tool calls, prompts and completions) to Langfuse; off when unset.
# https://cloud.langfuse.com
#   Project settings → API keys in Langfuse.
# LANGFUSE_SECRET_KEY=

# Langfuse public key.
# LANGFUSE_PUBLIC_KEY=

# Langfuse base URL (cloud region or self-hosted instance).
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# OTLP traces endpoint (http/protobuf). Any OpenTelemetry backend — Phoenix, Jaeger, Grafana, Honeycomb, Braintrust — receives the same agent-run spans as Langfuse; off when unset.
#   The /v1/traces URL of your collector or vendor.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Headers sent with every OTLP export, as key=value pairs separated by commas (vendor API keys go here).
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...

# Persist agent-run traces in the Mastra store (ai.mastra_ai_spans) so Mastra Studio's Traces view can show them. Grows without a retention sweep — keep off in production for now.
# ENGENTY_TRACE_STORE=false

# ── Secrets ──

# AES-256-GCM key for secret payloads at rest (32 bytes, base64). Generate: engenty env generate (or openssl rand -base64 32). Phase 1 static key; superseded by per-tenant DEK + KMS in phase 2.
# SECRETS_ENC_KEY=
