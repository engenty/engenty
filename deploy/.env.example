# Generated by `engenty env example` from apps/core/src/cli/env-setup/env-manifest.ts.
# Edit the manifest, then run: pnpm env:example:write — do not edit this file by hand.
# Interactive setup: pnpm dev:env:init

# Copy to deploy/.env and set values before:
# docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# Full guide: deploy/DEPLOY.md

# ── API security ──

# API JWT signing secret (device login, CLI, service tokens). Generate: engenty env generate.
ENGENTY_SECURITY_JWT_SECRET=

# ── Supabase ──

# Supabase API endpoint. Local: http://127.0.0.1:54321 (pnpm supabase:start). Production: project URL reachable from the Docker network.
SUPABASE_URL=

# Supabase secret key (server-side admin access — never expose to the browser). Local: from pnpm supabase → Secret (Authentication Keys).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Supabase anon/publishable key (public browser key). Production only — locally the UI reads VITE_SUPABASE_ANON_KEY from the root .env.local.
SUPABASE_ANON_KEY=

# Supabase API endpoint for the UI (Vite reads it from the workspace root; baked into production bundles at build time).
VITE_SUPABASE_URL=

# Supabase anon/publishable key for the UI (public browser key). Local: from pnpm supabase.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Production edge ──

# Public URL, single origin — Coolify Traefik should point HTTPS here → engenty-edge:8787. No trailing slash.
PUBLIC_APP_URL=https://app.example.com

# Port published on the host when not using Coolify routing only (optional).
# EDGE_PUBLISH_PORT=8787

# CORS for apps/ai (comma-separated origins allowed to call /ai).
ENGENTY_CORS_ORIGINS=https://app.example.com

# ── Production gateway flags ──

# Proxy /docs to the docs service (compose profile docs).
# ENGENTY_GATEWAY_DOCS_ENABLED=false

# Proxy /studio to Mastra Studio (compose profile studio).
# ENGENTY_GATEWAY_STUDIO_ENABLED=false

# HTTP basic auth on /studio (user:password).
# ENGENTY_GATEWAY_STUDIO_BASIC_AUTH=operator:change-me

# ── Agent sandbox (Docker-only) ──

# Prebaked agent sandbox runtime image (bun + python3 + uv). Build first: docker compose -f deploy/docker-compose.yml build.
ENGENTY_SANDBOX_DOCKER_IMAGE=engenty-sandbox:latest

# Host dir for sandbox staging; mirrored 1:1 into containers (see compose notes).
# ENGENTY_SANDBOX_HOST_DIR=/opt/engenty/sandboxes

# ── AI ──

# Vercel AI Gateway API key — required for the copilot (apps/ai). Create at https://vercel.com/d?to=/[team]/~/ai/api-keys
# https://vercel.com/docs/ai-gateway
#   1. Open the Vercel dashboard → AI Gateway → API keys
#   2. Create a key and copy it
AI_GATEWAY_API_KEY=

# OpenAI API key (optional fallback model provider / realtime voice).
# https://platform.openai.com/api-keys
#   Create a key under API keys in the OpenAI platform.
# OPENAI_API_KEY=
