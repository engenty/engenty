# syntax=docker/dockerfile:1
# Engenty production edge: core API + prod gateway + UI static assets.
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

FROM base AS deps
# scripts/ is needed by the root postinstall hook; the build warm-up it does is
# redundant here (turbo builds below), so skip it.
ENV ENGENTY_SKIP_INSTALL_BUILD=1
# `pnpm fetch` resolves + downloads every dependency into the local store using
# ONLY the lockfile (no package.json/source needed), so this layer stays cached
# across ANY source change and only busts when pnpm-lock.yaml changes. Without
# this split, copying full source before `pnpm install` invalidated the install
# layer on every commit, forcing a full network re-resolve each build.
COPY pnpm-lock.yaml ./
# The lockfile records a patched dependency, so `pnpm fetch` resolves the patch
# and dies with ERR_PNPM_PATCH_NOT_FOUND unless patches/ is already present.
# This is what broke every deploy image from v0.1.75 onward.
COPY patches ./patches
RUN pnpm fetch
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY scripts ./scripts
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules
RUN pnpm install --frozen-lockfile --offline

FROM deps AS build
ARG VITE_SUPABASE_URL=http://127.0.0.1:54321
ARG VITE_SUPABASE_ANON_KEY=placeholder
ARG VITE_ENGENTY_AI_BASE_URL=http://127.0.0.1:8787
# Lower on memory-constrained builders (each parallel tsup/tsc worker is heavy).
ARG TURBO_BUILD_CONCURRENCY=10
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_ENGENTY_AI_BASE_URL=$VITE_ENGENTY_AI_BASE_URL
# tsup --dts spawns tsc in a worker thread whose heap defaults low; a cold build
# of the full workspace (edge is the heaviest — core + UI + every package/module
# + manage) OOM'd it (ERR_WORKER_OUT_OF_MEMORY on @engenty/projects). Raise the
# worker heap; keep concurrency low (build-images.yml passes 2 for edge) so the
# concurrent DTS workers still fit the runner's RAM.
ENV NODE_OPTIONS=--max-old-space-size=4096
# ./packages/* and ./modules/* mirror the root predev: the UI's generated
# plugin catalog imports module/package plugins that are not package.json
# deps of @engenty/ui, so turbo won't build them via ^build alone.
#
# VITE_MANAGE_APP_ENABLED is baked into the UI bundle (turbo forwards VITE_* via
# Vite framework inference) and MUST match whether we actually ship the Manage
# portal below — otherwise a superadmin's Setup → Plugins hands off to a /manage
# that 404s. apps/manage is present in engenty-pro but excluded from the open
# mirror, so key the flag off the same directory check the build guard uses.
RUN VITE_MANAGE_APP_ENABLED=$([ -d apps/manage ] && echo true || echo false) \
    pnpm exec turbo run build --concurrency=$TURBO_BUILD_CONCURRENCY --filter='...@engenty/core' --filter=@engenty/ui --filter='./packages/*' --filter='./modules/*'
# Manage (closed PRO admin portal, served static under /manage) ships in
# engenty-pro only. Guard the build so this same Dockerfile still builds on the
# open mirror where apps/manage is absent; `mkdir -p` keeps the runtime COPY
# valid there (an empty root stays disabled by default).
RUN if [ -d apps/manage ]; then \
      pnpm exec turbo run build --concurrency=$TURBO_BUILD_CONCURRENCY --filter=@engenty/manage; \
    fi; \
    mkdir -p apps/manage/dist

FROM node:24-bookworm-slim AS runtime
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/core/package.json ./apps/core/
COPY --from=deps /app/node_modules ./node_modules
# pnpm links workspace deps inside the importer's own node_modules
# (apps/core/node_modules/@engenty/* -> ../../../packages/...), so ship both
# that link dir and the packages/ + modules/ trees (with dist) it points into.
COPY --from=deps /app/apps/core/node_modules ./apps/core/node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/modules ./modules
COPY --from=build /app/apps/core/dist ./apps/core/dist
COPY --from=build /app/apps/ui/dist ./apps/ui/dist
# Manage static bundle (empty on the open mirror; see the build stage).
COPY --from=build /app/apps/manage/dist ./manage

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8787
ENV ENGENTY_PROD_GATEWAY=1
ENV ENGENTY_GATEWAY_UI_ROOT=/app/apps/ui/dist
ENV ENGENTY_GATEWAY_MANAGE_ROOT=/app/manage
# Manage (apps/manage) ships in engenty-pro but stays OFF by default: it is a
# superadmin control plane, enabled only where intended. The PRO deployment
# opts in via ENGENTY_GATEWAY_MANAGE_ENABLED=true in compose/Coolify, which
# overrides this. On the open mirror /app/manage is empty, so /manage 404s.
ENV ENGENTY_GATEWAY_MANAGE_ENABLED=false
ENV ENGENTY_GATEWAY_AI_URL=http://engenty-ai:8790
ENV ENGENTY_GATEWAY_DOCS_URL=http://engenty-docs:3000
ENV ENGENTY_GATEWAY_STUDIO_URL=http://engenty-studio:43111
ENV GOTENBERG_URL=http://gotenberg:3000

EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/openapi.json').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/core/dist/api-entry.js"]
