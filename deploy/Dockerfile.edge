# syntax=docker/dockerfile:1-labs
# Engenty production edge: core API + prod gateway + UI static assets.
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

# `pnpm release` bumps `version` in the ROOT package.json on every single
# release, and the deps stage below copies that file — so the ~3.7 GB install
# layer was invalidated by the release process itself, forever. v0.1.108 moved
# the install above the source copy and still re-pulled ~1 GB on v0.1.109
# (`RUN pnpm install` executed, ~614s for ai) for exactly this reason.
#
# Normalise the version here and copy the RESULT into deps: BuildKit keys
# `COPY --from` on the CONTENT of the copied path, so deps sees a byte-identical
# manifest across releases and stays cached. This stage re-runs every release
# and costs nothing. The real version is restored in the runtime stage.
FROM base AS manifests
COPY package.json ./package.json
RUN sed -i 's/"version": *"[^"]*"/"version": "0.0.0-cache"/' ./package.json

FROM base AS deps
# The postinstall build warm-up is redundant here (turbo builds below).
ENV ENGENTY_SKIP_INSTALL_BUILD=1
# `pnpm fetch` resolves + downloads every dependency into the local store using
# ONLY the lockfile (no package.json/source needed), so this layer stays cached
# across ANY source change and only busts when pnpm-lock.yaml changes.
COPY pnpm-lock.yaml ./
# The lockfile records a patched dependency, so `pnpm fetch` resolves the patch
# and dies with ERR_PNPM_PATCH_NOT_FOUND unless patches/ is already present.
# This is what broke every deploy image from v0.1.75 onward.
COPY patches ./patches
RUN pnpm fetch
# Manifests ONLY above the install — never source.
#
# `pnpm install` produces the ~3.7 GB node_modules that dominates this image
# (~1 GB compressed; everything that actually changes per release is under
# 90 MB). BuildKit gives that COPY a fresh digest whenever the layer is
# rebuilt, so ANY per-commit input landing above it means production
# re-downloads the whole gigabyte on every release — and Coolify pulls AFTER
# removing the old containers, so that download happens with the site already
# down. Measured on v0.1.107: 188s of a 239s outage.
#
# --parents keeps each manifest at its own workspace path (hence the -labs
# frontend). The providers glob is a real workspace root — see pnpm-workspace.yaml.
COPY --from=manifests /app/package.json ./package.json
COPY pnpm-workspace.yaml ./
COPY --parents \
  apps/*/package.json \
  packages/*/package.json \
  modules/*/package.json \
  modules/*/providers/*/package.json \
  ./
# The root postinstall hook imports scripts/lib at module scope even though
# ENGENTY_SKIP_INSTALL_BUILD short-circuits it, so scripts/ must exist. It
# changes rarely; when it does we pay one extra full pull. That is the price of
# not passing --ignore-scripts, which would also skip dependencies' own native
# build scripts.
COPY scripts ./scripts
# @engenty/docs is the one workspace with an install hook (fumadocs-mdx), and it
# codegens from apps/docs/source.config.ts — source this stage deliberately does
# not have. None of the deploy images build docs, so exclude the workspace
# rather than drag its source above the install and re-break the caching this
# reorder exists to fix. Excluding it also keeps its deps out of the store.
RUN pnpm install --frozen-lockfile --offline --filter='!@engenty/docs'

FROM deps AS build
ARG VITE_SUPABASE_URL=http://127.0.0.1:54321
ARG VITE_SUPABASE_ANON_KEY=placeholder
ARG VITE_ENGENTY_AI_BASE_URL=http://127.0.0.1:8787
# Lower on memory-constrained builders (each parallel tsup/tsc worker is heavy).
ARG TURBO_BUILD_CONCURRENCY=10
COPY turbo.json tsconfig.base.json ./
# apps/ui and apps/manage bake the version into their bundles from this file
# (see apps/ui/vite.config.ts), so the deps stage's normalised 0.0.0-cache must
# not survive into the build — v0.1.110 and v0.1.111 both shipped an About
# dialog reading "0.0.0-cache". Restoring it here leaves the cached install
# layer above untouched; everything below it rebuilds on any source change
# anyway.
COPY package.json ./package.json
COPY apps ./apps
COPY packages ./packages
COPY modules ./modules
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_ENGENTY_AI_BASE_URL=$VITE_ENGENTY_AI_BASE_URL
# tsup --dts spawns tsc in a worker thread whose heap defaults low; a cold build
# of the full workspace (edge is the heaviest — core + UI + every package/module
# + manage) OOM'd it (ERR_WORKER_OUT_OF_MEMORY on @engenty/projects). Raise the
# worker heap; keep concurrency low (build-images.yml passes 2 for edge) so the
# concurrent DTS workers still fit the runner's RAM.
ENV NODE_OPTIONS=--max-old-space-size=4096
# ./packages/* and ./modules/* mirror the root predev: the UI's generated
# plugin catalog imports module/package plugins that are not package.json
# deps of @engenty/ui, so turbo won't build them via ^build alone.
#
# VITE_MANAGE_APP_ENABLED is baked into the UI bundle (turbo forwards VITE_* via
# Vite framework inference) and MUST match whether we actually ship the Manage
# portal below — otherwise a superadmin's Setup → Plugins hands off to a /manage
# that 404s. apps/manage is present in engenty-pro but excluded from the open
# mirror, so key the flag off the same directory check the build guard uses.
RUN VITE_MANAGE_APP_ENABLED=$([ -d apps/manage ] && echo true || echo false) \
    pnpm exec turbo run build --concurrency=$TURBO_BUILD_CONCURRENCY --filter='...@engenty/core' --filter=@engenty/ui --filter='./packages/*' --filter='./modules/*'
# Manage (closed PRO admin portal, served static under /manage) ships in
# engenty-pro only. Guard the build so this same Dockerfile still builds on the
# open mirror where apps/manage is absent; `mkdir -p` keeps the runtime COPY
# valid there (an empty root stays disabled by default).
RUN if [ -d apps/manage ]; then \
      pnpm exec turbo run build --concurrency=$TURBO_BUILD_CONCURRENCY --filter=@engenty/manage; \
    fi; \
    mkdir -p apps/manage/dist
# The sentinel is invisible until someone opens the About dialog in production;
# fail the build instead.
RUN ! grep -rqF "0.0.0-cache" apps/ui/dist apps/manage/dist

FROM node:24-bookworm-slim AS runtime
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
# pnpm links workspace deps inside the importer's own node_modules
# (apps/core/node_modules/@engenty/* -> ../../../packages/...), so ship both
# that link dir and the packages/ + modules/ trees (with dist) it points into.
COPY --from=deps /app/apps/core/node_modules ./apps/core/node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/modules ./modules
COPY --from=build /app/apps/core/dist ./apps/core/dist
COPY --from=build /app/apps/ui/dist ./apps/ui/dist
# Manage static bundle (empty on the open mirror; see the build stage).
COPY --from=build /app/apps/manage/dist ./manage

# Root package.json changes every release (the version bump), so it MUST land
# BELOW the multi-gigabyte node_modules copies above. A changed layer forces
# every later layer in the stage to be rebuilt, and a rebuilt layer gets a
# fresh digest — which is production re-downloading the whole image. Keeping
# it last is what lets the big layers stay byte-identical between releases.
# The real version also matters here: prod is verified with
# `docker exec ... head -3 /app/package.json`.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/core/package.json ./apps/core/

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8787
ENV ENGENTY_PROD_GATEWAY=1
ENV ENGENTY_GATEWAY_UI_ROOT=/app/apps/ui/dist
ENV ENGENTY_GATEWAY_MANAGE_ROOT=/app/manage
# Manage (apps/manage) ships in engenty-pro but stays OFF by default: it is a
# superadmin control plane, enabled only where intended. The PRO deployment
# opts in via ENGENTY_GATEWAY_MANAGE_ENABLED=true in compose/Coolify, which
# overrides this. On the open mirror /app/manage is empty, so /manage 404s.
ENV ENGENTY_GATEWAY_MANAGE_ENABLED=false
ENV ENGENTY_GATEWAY_AI_URL=http://engenty-ai:8790
ENV ENGENTY_GATEWAY_DOCS_URL=http://engenty-docs:3000
ENV ENGENTY_GATEWAY_STUDIO_URL=http://engenty-studio:43111
ENV GOTENBERG_URL=http://gotenberg:3000

EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/openapi.json').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/core/dist/api-entry.js"]
