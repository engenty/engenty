{
  "name": "engenty",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engenty": {
    "plugins": {
      "commercial-settings": {
        "source": "workspace"
      },
      "company-profile": {
        "source": "workspace"
      },
      "contacts": {
        "source": "workspace"
      },
      "engenty-coordinator": {
        "source": "workspace"
      },
      "engenty-copilot": {
        "source": "workspace"
      },
      "files": {
        "source": "workspace"
      },
      "invoices": {
        "source": "workspace"
      },
      "knowledge-base": {
        "source": "workspace"
      },
      "offers": {
        "source": "workspace"
      },
      "pdf-templates": {
        "source": "workspace"
      },
      "tasks": {
        "source": "workspace"
      },
      "projects": {
        "source": "workspace"
      },
      "team": {
        "source": "workspace"
      },
      "time-tracking": {
        "source": "workspace"
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "engenty": "node scripts/engenty-cli.mjs",
    "build": "turbo run build",
    "predev": "pnpm dev:check && turbo run build --filter=./packages/* --filter=./modules/*",
    "dev:check": "bash scripts/predev-check.sh",
    "dev": "turbo run api:app dev:app studio --filter=./apps/core --filter=./apps/ui --filter=./apps/ai --filter=./apps/docs",
    "predev:portless": "pnpm dev:check && turbo run build --filter=./packages/* --filter=./modules/*",
    "dev:portless": "bash scripts/dev-portless.sh",
    "dev:portless:ready": "node scripts/dev-portless-ready.mjs --turbo-pane",
    "dev:docs": "pnpm --filter @engenty/docs dev:app",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "ultracite check",
    "check:ui-core-imports": "node scripts/check-ui-core-imports.mjs",
    "check:supabase-imports": "node scripts/check-supabase-imports.mjs",
    "ai:check": "node scripts/ai-check.mjs",
    "lint": "pnpm run check",
    "fix": "ultracite fix",
    "setup": "pnpm engenty setup",
    "dev:env": "pnpm engenty env",
    "dev:env:init": "pnpm engenty env --init",
    "dev:env:check": "pnpm engenty env check",
    "dev:urls:localhost": "node scripts/sync-dev-env-localhost.mjs",
    "dev:urls:portless": "node scripts/sync-dev-env-from-portless.mjs",
    "env:example:write": "pnpm engenty env example --write",
    "env:example:check": "pnpm engenty env example --check",
    "portless:setup": "node scripts/portless-setup.mjs",
    "portless": "bash scripts/portless-proxy-start.sh",
    "portless:proxy:check": "bash scripts/portless-proxy-check.sh",
    "service:jwt": "node scripts/mint-service-jwt.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:config:check": "node scripts/check-committed-supabase-config.mjs",
    "plugins:check": "node scripts/check-engenty-plugins.mjs",
    "db:init": "pnpm engenty db init",
    "db:migrate": "pnpm engenty db migrate",
    "db:reset": "pnpm engenty db reset",
    "db:restart": "pnpm engenty db restart",
    "db:snapshot": "pnpm engenty db snapshot",
    "db:restore": "pnpm engenty db restore",
    "clean": "bash scripts/clean.sh",
    "purge": "bash scripts/purge.sh",
    "purge:light": "bash scripts/purge.sh --light",
    "push": "bash scripts/publish-open.sh"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vitest/coverage-v8": "^4.1.9",
    "http-server": "^14.1.1",
    "jose": "^6.2.3",
    "portless": "^0.15.0",
    "tailwindcss": "^4.3.1",
    "turbo": "^2.9.18",
    "ultracite": "7.8.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^6",
      "@engenty/ai>ai": "7.0.0-beta.116",
      "ai": "6.0.116",
      "@xmldom/xmldom": ">=0.9.10",
      "dompurify": ">=3.4.0",
      "lodash-es": "4.18.1",
      "picomatch": "4.0.4",
      "yaml": "2.9.0",
      "zod": "4.4.3",
      "protobufjs": ">=7.5.8",
      "@protobufjs/utf8": ">=1.1.1",
      "axios": ">=1.16.0",
      "fast-uri": ">=3.1.2",
      "react-router": ">=7.15.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1",
      "mermaid": ">=11.15.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ]
}
