{
  "name": "engenty",
  "version": "0.2.5",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engenty": {
    "plugins": {
      "browser-bridge": {
        "source": "workspace"
      },
      "commercial-settings": {
        "source": "workspace"
      },
      "company-profile": {
        "source": "workspace"
      },
      "connections": {
        "source": "workspace"
      },
      "connections-external": {
        "source": "workspace"
      },
      "connections-github": {
        "source": "workspace"
      },
      "connections-google": {
        "source": "workspace"
      },
      "connections-hubspot": {
        "source": "workspace"
      },
      "connections-local-files": {
        "source": "workspace"
      },
      "connections-microsoft": {
        "source": "workspace"
      },
      "connections-s3": {
        "source": "workspace"
      },
      "connections-slack": {
        "source": "workspace"
      },
      "contacts": {
        "source": "workspace"
      },
      "engenty-copilot": {
        "source": "workspace"
      },
      "files": {
        "source": "workspace"
      },
      "inbox": {
        "source": "workspace"
      },
      "invoices": {
        "source": "workspace"
      },
      "knowledge-base": {
        "source": "workspace"
      },
      "offers": {
        "source": "workspace"
      },
      "pdf-templates": {
        "source": "workspace"
      },
      "projects": {
        "source": "workspace"
      },
      "secrets": {
        "source": "workspace"
      },
      "tasks": {
        "source": "workspace"
      },
      "team": {
        "source": "workspace"
      },
      "team-chat": {
        "source": "workspace"
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "engenty": "node scripts/engenty-cli.mjs",
    "kill": "bash scripts/kill.sh",
    "build": "turbo run build --concurrency=4",
    "dev": "pnpm engenty dev",
    "dev:portless": "pnpm engenty dev --portless",
    "dev:portless:ready": "node scripts/dev-portless-ready.mjs --turbo-pane",
    "dev:docs": "pnpm --filter @engenty/docs dev:app",
    "dev:www": "pnpm --filter @engenty/www dev:app",
    "typecheck": "turbo run typecheck --concurrency=4 --continue",
    "test": "NODE_OPTIONS=\"--localstorage-file=${TMPDIR:-/tmp}/engenty-vitest-localstorage\" VITEST_MAX_WORKERS=2 turbo run test test:scripts --concurrency=4",
    "test:all": "vitest run",
    "test:scripts": "vitest run scripts/",
    "test:smoke": "playwright test",
    "test:smoke:mobile": "playwright test --project=mobile-safari --project=mobile-chrome",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "ultracite check",
    "check:test-wiring": "node scripts/check-test-wiring.mjs",
    "check:ui-core-imports": "node scripts/check-ui-core-imports.mjs",
    "check:viewport-units": "node scripts/check-viewport-units.mjs",
    "check:shell-chrome": "node scripts/check-shell-chrome.mjs",
    "check:supabase-imports": "node scripts/check-supabase-imports.mjs",
    "check:rls-coverage": "node scripts/check-rls-coverage.mjs",
    "check:server-lane-coverage": "node scripts/check-server-lane-coverage.mjs",
    "check:leak-harness": "node scripts/leak-harness.mjs",
    "check:foreign-schema-scope": "node scripts/check-foreign-schema-scope.mjs",
    "check:space-storage-scope": "node scripts/check-space-storage-scope.mjs",
    "check:grants-coverage": "node scripts/check-grants-coverage.mjs",
    "check:mcp-inventory": "node scripts/check-mcp-operation-inventory.mjs",
    "ai:check": "node scripts/ai-check.mjs",
    "lint": "pnpm run check",
    "fix": "ultracite fix",
    "lockfile:check": "pnpm install --frozen-lockfile",
    "dev:urls:localhost": "node scripts/sync-dev-env-localhost.mjs",
    "dev:urls:portless": "node scripts/sync-dev-env-from-portless.mjs",
    "env:example:write": "pnpm engenty env example --write",
    "env:example:check": "pnpm engenty env example --check",
    "readme:modules:write": "node scripts/render-readme-modules.mjs --write",
    "readme:modules:check": "node scripts/render-readme-modules.mjs --check",
    "portless:setup": "node scripts/portless-setup.mjs",
    "portless": "bash scripts/portless-proxy-start.sh",
    "portless:proxy:check": "bash scripts/portless-proxy-check.sh",
    "supabase:config:check": "node scripts/check-committed-supabase-config.mjs",
    "plugins:check": "node scripts/check-engenty-plugins.mjs",
    "clean": "bash scripts/clean.sh",
    "push": "bash scripts/publish-open.sh",
    "push:snapshot": "bash scripts/publish-open-snapshot.sh",
    "about:data": "node scripts/write-about-data.mjs",
    "release": "node scripts/release.mjs",
    "release:changelog": "node scripts/release.mjs --changelog",
    "release:desktop": "node scripts/release-desktop.mjs",
    "check:work-vocabulary": "node scripts/check-work-vocabulary.mjs",
    "check:supabase-pin": "node scripts/check-supabase-pin.mjs",
    "publish:cli": "node scripts/publish-cli.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vitest/coverage-v8": "^4.1.11",
    "git-cliff": "^2.13.1",
    "http-server": "^14.1.1",
    "jose": "^6.2.12",
    "portless": "^0.15.6",
    "supabase": "2.117.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.13",
    "ultracite": "7.8.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        },
        "peerDependenciesMeta": {
          "zod": {
            "optional": true
          }
        }
      },
      "@ag-ui/mastra": {
        "peerDependenciesMeta": {
          "@copilotkit/runtime": {
            "optional": true
          }
        }
      }
    },
    "overrides": {
      "typescript": "^6",
      "ai": "7.0.102",
      "chat": "4.40.0",
      "@xmldom/xmldom": ">=0.9.10",
      "dompurify": ">=3.4.0",
      "lodash-es": "4.18.1",
      "picomatch": "4.0.4",
      "yaml": "2.9.1",
      "zod": "4.6.5",
      "@a2ui/web_core>zod": "3.25.76",
      "@a2ui/react>zod": "3.25.76",
      "@a2ui/markdown-it>zod": "3.25.76",
      "@engenty/a2ui-catalog>zod": "3.25.76",
      "@ag-ui/core>zod": "3.25.76",
      "@ag-ui/client>zod": "3.25.76",
      "@fast-csv/format>@types/node": "26.0.0",
      "@fast-csv/parse>@types/node": "26.0.0",
      "@executor-js/plugin-openapi": "1.6.7",
      "effect": "4.0.0-beta.59",
      "protobufjs": ">=7.5.8",
      "@protobufjs/utf8": ">=1.1.1",
      "axios": ">=1.16.0",
      "fast-uri": ">=3.1.2",
      "react-router": ">=7.15.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1",
      "mermaid": ">=11.15.0",
      "@a2ui/markdown-it": "0.1.0",
      "rxjs": "7.8.1"
    },
    "patchedDependencies": {
      "@rivet-dev/agentos-apps@0.2.19": "patches/@rivet-dev__agentos-apps@0.2.19.patch",
      "@mastra/memory@1.30.0": "patches/@mastra__memory@1.30.0.patch"
    },
    "ignoredBuiltDependencies": [
      "cbor-extract",
      "cpu-features",
      "isolated-vm",
      "koffi",
      "msgpackr-extract",
      "protobufjs",
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "@google/genai",
      "better-sqlite3",
      "esbuild",
      "ssh2"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "@copilotkit/runtime"
      ]
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*",
    "modules/*/providers/*"
  ]
}