{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "40",
  "globalDependencies": [".env", ".env.local", ".env.*.local"],
  "globalEnv": [
    "ENV",
    "ENGENTY_DEV_READY_MAX_WAIT_MS",
    "ENGENTY_DEV_DOMAIN",
    "ENGENTY_UI_PORT",
    "ENGENTY_CORE_PORT",
    "ENGENTY_AI_PORT",
    "ENGENTY_DOCS_PORT",
    "ENGENTY_STUDIO_PORT",
    "ENGENTY_DEV_GATEWAY_UI_URL",
    "ENGENTY_DEV_GATEWAY_AI_URL",
    "ENGENTY_DEV_GATEWAY_DOCS_URL",
    "ENGENTY_DEV_GATEWAY_STUDIO_URL",
    "ENGENTY_DEV_GATEWAY_MANAGE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "generate:plugins": {
      "cache": false,
      "outputs": [
        "apps/ui/src/plugins/generated-catalog.ts",
        "apps/ui/src/plugins/generated-tailwind-sources.css"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:app": {
      "cache": false,
      "persistent": true
    },
    "dev:portless": {
      "cache": false,
      "persistent": true
    },
    "dev:portless:ready": {
      "cache": false,
      "persistent": true
    },
    "api": {
      "cache": false,
      "persistent": true
    },
    "api:app": {
      "cache": false,
      "persistent": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/test/setup.ts",
        "$TURBO_ROOT$/apps/core/test/vitest-setup-root-chdir.ts"
      ],
      "outputs": [],
      "env": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_ANON_KEY",
        "SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY"
      ],
      "passThroughEnv": [
        "VITEST_MAX_WORKERS",
        "VITEST_MAX_FORKS",
        "VITEST_MIN_FORKS"
      ]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**", "vitest.config.ts", "test/setup.ts"],
      "outputs": [],
      "env": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_ANON_KEY",
        "SUPABASE_PUBLISHABLE_KEY",
        "VITE_SUPABASE_ANON_KEY"
      ],
      "passThroughEnv": [
        "VITEST_MAX_WORKERS",
        "VITEST_MAX_FORKS",
        "VITEST_MIN_FORKS"
      ]
    }
  }
}
