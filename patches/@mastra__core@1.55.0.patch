@@ -21671,6 +21671,14 @@ var ChatChannelOutputProcessor = class {
 				throw err;
 			})
 		};
+		// engenty patch: the `throw err` above re-rejects driverPromise, which stays
+		// unowned until the terminal-chunk await in processOutputStream. If the driver
+		// fails EARLY (first adapter post: bad token, platform outage) that window makes
+		// the rejection unhandled and crashes the whole process. Attach a no-op catch so
+		// the rejection is owned; the later `await session.driverPromise` still observes
+		// it and logs "channel render driver failed".
+		rendered.driverPromise.catch(() => {});
+		return rendered;
 	}
