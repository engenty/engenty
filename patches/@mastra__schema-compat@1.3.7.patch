@@ -5224,6 +5224,15 @@ var OpenAISchemaCompatLayer = class extends SchemaCompatLayer {
 							...propSchema,
 							type: originalType
 						}, { type: "null" }];
+						// engenty patch: every sibling keyword was copied into the anyOf
+						// branch and LEFT on the parent, so each optional enum, item
+						// schema and description was serialised twice — 30,795 B across
+						// one copilot tool block (27% of it). It also made the branch
+						// unsatisfiable: JSON Schema ANDs sibling keywords, so a parent
+						// `enum` forbids the `null` the branch was built to allow. Drop
+						// the copies, exactly as the array/object branch above already
+						// does with `delete prop[keyword]`.
+						for (const keyword of Object.keys(propSchema)) delete prop[keyword];
 					}
 				}
 			}
