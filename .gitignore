node_modules
dist
/data
/tmp
*.log
.DS_Store
.turbo
.next
.sync

# Secrets — never commit
*.key
*.crt
*.pem
.env
.env.*
!.env.example

# Aggregated migrations (generated; do not commit)
supabase/migrations/*.sql

# Local Supabase config (generated from config.toml.example + supabase:sync)
supabase/config.toml

# UI plugin artifacts (generated from modules/packages on disk)
apps/ui/src/plugins/generated-catalog.ts
apps/ui/src/plugins/generated-tailwind-sources.css
apps/ui/src/plugins/pro/

# Local database snapshots
supabase/snapshots/

# Test coverage output
coverage/

# Logs
logs/

# Local dev slot registry (worktree portless)
.engenty/

# LLM call traces (ENGENTY_LLM_TRACE) — tenant conversation data
.llm-trace/

# Local Claude Code preview server config
.claude/launch.json

# Claude Code worktrees — never commit these (a stray gitlink here breaks
# actions/checkout submodule handling on CI)
.claude/worktrees/

# Playwright smoke lane
e2e/.auth/
e2e/.results/
e2e/.report/

# dev-only visual harness for the action canvas (not shipped)
apps/ui/canvas-preview.html
apps/ui/src/canvas-preview.tsx
