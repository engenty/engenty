{
  "name": "@engenty/pdf-templates",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts --format esm --clean",
    "dev": "tsup src/index.ts src/core.ts --format esm --watch",
    "test": "vitest run --root ../.. packages/pdf-templates/",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/api-client": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/pdf-service": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^10.5.0",
    "react-resizable-panels": "^4.12.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
