{
  "name": "@engenty/platform-settings",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./ui/index.ts",
      "default": "./ui/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run --root ../.. packages/platform-settings/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/api-client": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/secrets-sdk": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.46.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
