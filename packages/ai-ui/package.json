{
  "name": "@engenty/ai-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./embed": {
      "types": "./src/embed.ts",
      "default": "./dist/embed.js"
    },
    "./plugin": {
      "types": "./src/plugin.tsx",
      "default": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/embed.ts src/plugin.tsx --format esm --clean --external @firecrawl/anydoc-wasm --external @llamaindex/liteparse-wasm --external @tanstack/react-hotkeys --external @tanstack/hotkeys",
    "dev": "tsup src/index.ts src/embed.ts src/plugin.tsx --format esm --watch --external @firecrawl/anydoc-wasm --external @llamaindex/liteparse-wasm --external @tanstack/react-hotkeys --external @tanstack/hotkeys",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/a2ui-catalog": "workspace:*",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/notifications-ui": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/api-contracts": "workspace:*",
    "@engenty/app-shell": "workspace:*",
    "@engenty/environment": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/import": "workspace:*",
    "@engenty/live-cache": "workspace:*",
    "@engenty/mcp-server": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@engenty/query-client": "workspace:*",
    "@engenty/search-index": "workspace:*",
    "@engenty/tiptap-editor": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@firecrawl/anydoc-wasm": "^0.1.9",
    "@floating-ui/dom": "^1.8.0",
    "@llamaindex/liteparse-wasm": "^2.14.6",
    "@monaco-editor/react": "^4.7.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/core": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.11.6",
    "ai": "7.0.102",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.46.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.1",
    "streamdown": "^2.6.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
