{
  "name": "@engenty/a2ui-catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/spec.ts --format esm --dts --clean --external @engenty/ui-core",
    "dev": "tsup src/index.ts src/spec.ts --format esm --dts --watch --external @engenty/ui-core",
    "test": "vitest run",
    "lint": "echo 'No lint yet'"
  },
  "dependencies": {
    "@a2ui/react": "0.10.2",
    "@a2ui/web_core": "0.10.5",
    "@engenty/ui-core": "workspace:*",
    "lucide-react": "^1.21.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
