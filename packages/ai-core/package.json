{
  "name": "@engenty/ai-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm --clean && node postbuild.mjs",
    "dev": "tsup src/index.ts src/browser.ts --format esm --watch --onSuccess \"node postbuild.mjs\"",
    "provider:add": "tsx scripts/provider-add.ts",
    "provider:update": "tsx scripts/provider-update.ts",
    "embedding:update": "tsx scripts/embedding-provider-update.ts",
    "test": "vitest run --root ../.. packages/ai-core",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@11ty/gray-matter": "^2.1.0",
    "@ai-sdk/anthropic": "4.0.54",
    "@ai-sdk/openai": "^4.0.67",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "ai": "7.0.102",
    "ajv": "^8.20.0",
    "sharp": "^0.35.4",
    "uuidv7": "^1.2.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@engenty/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@engenty/plugin-sdk": "workspace:*",
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
