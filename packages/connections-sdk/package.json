{
  "name": "@engenty/connections-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/approvals-sdk": "workspace:*",
    "@engenty/platform-settings": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@types/node": "^24.0.0"
  }
}
