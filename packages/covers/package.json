{
  "name": "@engenty/covers",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "default": "./dist/ui/index.js"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/ui/index.ts src/server/index.ts --format esm --clean",
    "test": "vitest run --root ../.. packages/covers/",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/ai-core": "workspace:*",
    "@engenty/api-client": "workspace:*",
    "@engenty/file-storage": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/plugin-sdk": "workspace:*",
    "@engenty/query-client": "workspace:*",
    "@engenty/telemetry": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "lucide-react": "^1.46.0",
    "sonner": "^2.0.8",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
