{
  "name": "@engenty/commercial-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./placeholders": {
      "types": "./src/placeholders.ts",
      "default": "./dist/placeholders.js"
    },
    "./blocks": {
      "types": "./src/blocks-normalize.ts",
      "default": "./dist/blocks-normalize.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/placeholders.ts src/blocks-normalize.ts --format esm --clean",
    "dev": "tsup src/index.ts src/placeholders.ts src/blocks-normalize.ts --format esm --watch",
    "test": "vitest run --root ../.. packages/commercial-editor/",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/i18n": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
