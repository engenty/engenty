{
  "name": "@engenty/i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./src/ui.tsx",
      "default": "./dist/ui.js"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/ui.tsx src/core.ts --format esm --clean",
    "dev": "tsup src/index.ts src/ui.tsx src/core.ts --format esm --watch",
    "test": "vitest run --root ../.. packages/i18n/",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.0.14"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
