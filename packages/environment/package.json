{
  "name": "@engenty/environment",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./dist/env.js"
    },
    "./engenty-modules": {
      "types": "./src/engenty-modules.ts",
      "default": "./dist/engenty-modules.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/env.ts src/engenty-modules.ts src/dev-service-urls.ts src/dev-service-urls.fixture.ts --format esm --clean",
    "dev": "tsup src/index.ts src/env.ts src/engenty-modules.ts src/dev-service-urls.ts src/dev-service-urls.fixture.ts --format esm --watch",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "happy-dom": "^20.10.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
