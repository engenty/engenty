{
  "name": "@engenty/app-shell",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./navigation": {
      "types": "./src/navigation.ts",
      "default": "./dist/navigation.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/navigation.ts --format esm --clean --external @tanstack/react-hotkeys --external @tanstack/hotkeys",
    "dev": "tsup src/index.ts src/navigation.ts --format esm --watch --external @tanstack/react-hotkeys --external @tanstack/hotkeys",
    "test": "vitest run",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ui-core": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@engenty/ui-plugin-sdk": "workspace:*",
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/react-hotkeys": "0.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
