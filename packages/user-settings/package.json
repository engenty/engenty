{
  "name": "@engenty/user-settings",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup index.ts --format esm --clean",
    "dev": "tsup index.ts src/dal/index.ts src/api/index.ts src/schema/zod.ts src/types.ts --format esm --watch",
    "test": "vitest run -r ../.. packages/user-settings",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/plugin-sdk": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@supabase/supabase-js": "^2.116.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
