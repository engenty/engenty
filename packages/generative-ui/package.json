{
  "name": "@engenty/generative-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./dist/catalog.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/catalog.ts src/registry.tsx --format esm --clean --external @engenty/ui-core",
    "dev": "tsup src/index.ts src/catalog.ts src/registry.tsx --format esm --watch --external @engenty/ui-core",
    "test": "vitest run --root ../.. --passWithNoTests packages/generative-ui/",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/ui-core": "workspace:*",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@json-render/shadcn": "^0.19.0",
    "lucide-react": "^1.21.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
