{
  "name": "@engenty/ui-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check:imports": "node ../../scripts/check-ui-core-imports.mjs",
    "build": "tsup src/index.ts --format esm --clean --external @engenty/environment --external @engenty/i18n --external @engenty/ui-icons --external @ai-sdk/react --external @tanstack/react-hotkeys --external @tanstack/hotkeys",
    "dev": "tsup src/index.ts --format esm --watch --external @engenty/environment --external @engenty/i18n --external @engenty/ui-icons --external @ai-sdk/react --external @tanstack/react-hotkeys --external @tanstack/hotkeys",
    "test": "vitest run",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.105",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/environment": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@floating-ui/dom": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/hotkeys": "0.8.0",
    "@tanstack/react-hotkeys": "0.10.0",
    "ai": "7.0.102",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "frimousse": "^0.3.0",
    "lucide-react": "^1.46.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.88.0",
    "recharts": "3.8.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
