{
  "name": "@engenty/ui-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check:imports": "node ../../scripts/check-ui-core-imports.mjs",
    "build": "tsup src/index.ts --format esm --dts --clean --external @engenty/environment --external @engenty/i18n --external @engenty/ui-icons --external @ai-sdk/react",
    "dev": "tsup src/index.ts --format esm --dts --watch --external @engenty/environment --external @engenty/i18n --external @engenty/ui-icons --external @ai-sdk/react",
    "test": "vitest run",
    "lint": "echo 'No lint yet'"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.61",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@engenty/ag-ui-bridge": "workspace:*",
    "@engenty/ai-core": "workspace:*",
    "@engenty/environment": "workspace:*",
    "@engenty/i18n": "workspace:*",
    "@engenty/ui-icons": "workspace:*",
    "@floating-ui/dom": "^1.7.6",
    "@hookform/resolvers": "^5.4.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "frimousse": "^0.3.0",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.15",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.80.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
