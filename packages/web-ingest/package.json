{
  "name": "@engenty/web-ingest",
  "version": "0.0.1",
  "private": true,
  "description": "HTML→Markdown (Turndown+GFM), bounded URL fetch, CSS extract defaults, optional LLM selector hints, optional Firecrawl scrape",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run --config vitest.config.ts",
    "lint": "echo 'No lint yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engenty/telemetry": "workspace:*",
    "ai": "7.0.58",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
