# Generated by `engenty env example` from apps/core/src/cli/env-setup/env-manifest.ts.
# Edit the manifest, then run: pnpm env:example:write — do not edit this file by hand.
# Interactive setup: pnpm dev:env:init

# Copy to .env.local (or run pnpm dev:env:init). Production values live in deploy/.env.example.

# ── Workspace ──

# Workspace tier for `@engenty/environment` (e.g. user menu Developer mode). Use `development` locally.
# ENV=development

# ── Dev URLs (generated block — pnpm dev:urls:localhost or pnpm dev:urls:portless) ──
# Default: http://localhost:5173 (Vite). Optional HTTPS: docs/dev/portless-local-urls.md
# ENGENTY_UI_BASE_URL=
# ENGENTY_API_BASE_URL=
# ENGENTY_AI_BASE_URL=
# ENGENTY_DOCS_BASE_URL=
# ENGENTY_CORE_BASE_URL=
# ENGENTY_CORS_ORIGINS=
# VITE_ENGENTY_AI_BASE_URL=
# NEXT_PUBLIC_DOCS_SITE_URL=

# ── API security ──

# API JWT signing secret (device login, CLI, service tokens). Generate: engenty env generate.
ENGENTY_SECURITY_JWT_SECRET=

# Registers the agent escalation policy: an agent-driven operation whose required capabilities fall outside the agent's role grants ∪ its goal grants escalates to approval instead of running. Ship it on — the 2026-08-03 audit found this policy cited as a governing gate while being registered nowhere, so agent runs were left to the blanket escalation alone. Set to anything but `true` only to debug that policy.
# ENGENTY_AGENT_ESCALATION=true

# The service credential for apps/ai (scheduler, task dispatcher, remote channels), as `<credentialId>.<secret>` from `engenty service-token create --name ai-service`. apps/ai exchanges it at POST /api/auth/service-token for a 15-minute engenty token per tenant — no Supabase user, revocable with `engenty service-token revoke`, capabilities clamped at creation.
# ENGENTY_AI_SERVICE_SECRET=

# ── Supabase ──

# Supabase API endpoint. Local: http://127.0.0.1:54321 (pnpm supabase:start). Production: project URL reachable from the Docker network.
SUPABASE_URL=http://127.0.0.1:54321

# Supabase secret key (server-side admin access — never expose to the browser). Local: from pnpm supabase → Secret (Authentication Keys).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Direct Postgres connection string. Two uses: (1) apps/ai Mastra framework storage (workflow/run snapshots, native suspend/resume — without it Mastra falls back to in-memory); (2) the deploy migrate init-service applies pending migrations to it on each deploy. The service-role key can't run DDL, so this is REQUIRED for automatic migrations (unset ⇒ the migrate step is skipped and you apply migrations manually). Local default matches the Supabase CLI stack.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase API endpoint for the UI (Vite reads it from the workspace root; baked into production bundles at build time).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/publishable key for the UI (public browser key). Local: from pnpm supabase.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Observability (LangFuse) ──

# LangFuse secret key (LLM tracing; disabled when unset).
# https://cloud.langfuse.com
#   Project settings → API keys in LangFuse.
# LANGFUSE_SECRET_KEY=

# LangFuse public key.
# LANGFUSE_PUBLIC_KEY=

# LangFuse base URL (cloud region or self-hosted instance).
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── UI (Vite) ──

# Omit for same-origin /api via the Vite dev proxy (http://localhost:5173 → core on :8787).
# VITE_API_BASE_URL=

# Persist copilot composer draft across refresh (off by default).
# VITE_COPILOT_COMPOSER_DRAFT_RECOVERY=true

# ── Dev login ──

# Dev auto-login email (core dev-login routes).
# ENGENTY_DEV_EMAIL=

# Dev auto-login password.
# ENGENTY_DEV_PASS=

# Dev auto-login email prefilled in the UI login form.
# VITE_ENGENTY_DEV_EMAIL=

# Dev auto-login password prefilled in the UI login form.
# VITE_ENGENTY_DEV_PASS=

# ── Core API & AI workspace ──

# Core API (apps/core): optional Vault office preview via Gotenberg.
# GOTENBERG_URL=http://127.0.0.1:3000

# Workspace filesystem backend for agent workspaces (e.g. file-storage, remote, local).
# ENGENTY_WORKSPACE_FS=

# Agent code sandbox provider. docker is the only supported value (sandbox doctrine 2026-08-03); any other value fails loudly at resolve.
# ENGENTY_SANDBOX_PROVIDER=docker

# Set to false to stop sending email notifications for unread in-app notifications. Any other value (or unset) leaves them on.
# ENGENTY_EMAIL_NOTIFICATIONS_ENABLED=true

# How long a notification stays unread before it is emailed, in minutes. Defaults to 5.
# ENGENTY_EMAIL_NOTIFICATION_DELAY_MINUTES=5

# Which notification sources may be emailed: comma-separated list, or * for all. Defaults to team-chat.
# ENGENTY_EMAIL_NOTIFICATION_SOURCES=team-chat

# Supabase Storage bucket for agent workspace files.
# ENGENTY_WORKSPACE_STORAGE_BUCKET=files

# ── engenty Apps ──

# Internal URL of apps/app-host (apps/ai → app-host). Never published and never a gateway target — app-host runs tenant-authored code, so it gets no origin of its own.
# ENGENTY_APP_HOST_URL=http://127.0.0.1:8795

# Shared secret apps/ai presents on every app-host internal call. Required in production — app-host refuses to boot without it.
# ENGENTY_APP_HOST_TOKEN=generate-a-random-64-char-secret

# Local port for apps/app-host (internal only).
# ENGENTY_APP_HOST_PORT=8795

# Deployment-wide kill switch for engenty Apps. Set to false and the module registers no operations at all — nothing to reach. Per-tenant gating is module licensing; per-app gating is app_archive.
# ENGENTY_APPS_ENABLED=true

# ── Logging & debug ──

# CLI/server log level: debug | info | warn | error.
# LOG_LEVEL=info

# Local log output directory.
# LOG_DIR=

# evlog structured log directory.
# EVLOG_LOG_DIR=

# Axiom ingest token for structured logs (optional).
# AXIOM_TOKEN=

# AI debug logging: =1 to enable (packages/ai-core).
# AI_DEBUG=1

# AI debug log directory.
# AI_DEBUG_LOG_DIR=

# AI debug log file name.
# AI_DEBUG_LOG_FILE=

# AI debug: also log to stdout (=1).
# AI_DEBUG_LOG_STDOUT=

# ── Connections ──

# AES-256-GCM key for connection tokens at rest (32 bytes, base64). Generate: openssl rand -base64 32.
# CONNECTIONS_TOKEN_ENC_KEY=

# Override the OAuth callback URL when core is behind a public proxy. Default: <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
# CONNECTIONS_REDIRECT_URI=

# ── Connections — External ──

# Base URL of the integrations.sh-compatible registry used for connector discovery. Only contacted during admin import/refresh, never at agent runtime. Defaults to https://integrations.sh.
# ENGENTY_INTEGRATIONS_REGISTRY_URL=

# ── Connections — GitHub ──

# GitHub OAuth App client ID for the GitHub connector.
# https://github.com/settings/developers
#   1. Create an OAuth App at https://github.com/settings/developers → New OAuth App.
#   2. Set Authorization callback URL to: <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
#   3. Request scope 'repo' at connect time (configured by the connector).
#   4. Copy the Client ID from the app's General page.
# GITHUB_OAUTH_CLIENT_ID=

# GitHub OAuth App client secret for the GitHub connector.
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Connections — Google ──

# Google OAuth 2.0 client ID used by the Gmail, Drive, Calendar and Contacts connectors.
# https://console.cloud.google.com/apis/credentials
#   Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console → APIs & Services → Credentials.
#   Add the authorized redirect URI: <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
#   Enable the Gmail, Drive, Calendar and People APIs for the project.
# GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth 2.0 client secret for the same OAuth client as GOOGLE_OAUTH_CLIENT_ID.
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── Connections — Microsoft ──

# Application (client) ID of the Azure app registration used for the Microsoft Graph OAuth flow (tenant: common).
# https://portal.azure.com
#   1. Open the Azure Portal → App registrations and create a registration (supported account types: any org directory + personal Microsoft accounts).
#   2. Add the Web redirect URI <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
#   3. Under API permissions, add the delegated Microsoft Graph permissions: User.Read, Mail.Read, Mail.ReadWrite, Mail.Send, Calendars.Read, Calendars.ReadWrite, Files.Read, Files.ReadWrite.
#   4. Copy the Application (client) ID from the Overview page.
# MICROSOFT_OAUTH_CLIENT_ID=

# Client secret of the Azure app registration (Certificates & secrets → New client secret; copy the secret Value).
# MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Connections — Slack ──

# Slack OAuth v2 client ID for the Slack connector.
# https://api.slack.com/apps
#   1. Create an app at https://api.slack.com/apps (from scratch).
#   2. Under OAuth & Permissions → User Token Scopes add: channels:read, groups:read, channels:history, groups:history, search:read, chat:write, reactions:write, users:read.
#   3. Under OAuth & Permissions → Redirect URLs add: <ENGENTY_API_BASE_URL>/api/connections/oauth/callback.
#   4. Copy the Client ID from Basic Information → App Credentials.
# SLACK_OAUTH_CLIENT_ID=

# Slack OAuth v2 client secret for the Slack connector.
# SLACK_OAUTH_CLIENT_SECRET=

# ── AI ──

# Vercel AI Gateway API key — required for the copilot (apps/ai). Create at https://vercel.com/d?to=/[team]/~/ai/api-keys
# https://vercel.com/docs/ai-gateway
#   1. Open the Vercel dashboard → AI Gateway → API keys
#   2. Create a key and copy it
AI_GATEWAY_API_KEY=

# Default model routed through the AI Gateway (e.g. anthropic/claude-sonnet-4-6).
# AI_GATEWAY_DEFAULT_MODEL=anthropic/claude-sonnet-4-6

# Enable apps/ai to refresh the Gateway model catalog from Vercel AI Gateway on a schedule.
# AI_GATEWAY_MODEL_SYNC_ENABLED=true

# Run Gateway model catalog sync when apps/ai starts (populates copilot model dropdowns after fresh setup).
# AI_GATEWAY_MODEL_SYNC_RUN_ON_START=true

# OpenAI API key (optional fallback model provider / realtime voice).
# https://platform.openai.com/api-keys
#   Create a key under API keys in the OpenAI platform.
# OPENAI_API_KEY=

# Mistral API key — enables the Voxtral speech-to-text leg of the Voxtral+ElevenLabs realtime voice cascade. Without it the cascade provider is not registered and tenants selecting it get HTTP 501.
# https://console.mistral.ai/api-keys
#   Create a key under API Keys in the Mistral console.
# MISTRAL_API_KEY=

# ElevenLabs API key — enables the text-to-speech leg of the Voxtral+ElevenLabs realtime voice cascade (Austrian/Bavarian dialect voices). Required together with MISTRAL_API_KEY. The key must include voices_read and text_to_speech permissions.
# https://elevenlabs.io/app/settings/api-keys
#   Create a key under Profile → API Keys in the ElevenLabs app.
#   Enable at least voices_read and text_to_speech (restricted keys without voices_read cannot populate the voice dropdown).
# ELEVENLABS_API_KEY=

# ── Remote channels ──

# Kill switch for the remote channel runtime (webhook ingress + channel agent) in apps/ai. On by default: the runtime activates whenever a platform is configured (SLACK_BOT_TOKEN + SLACK_SIGNING_SECRET, or TELEGRAM_BOT_TOKEN). Set to false to shut ingress off without removing those credentials.
# ENGENTY_REMOTE_CHANNELS_ENABLED=true

# Slack app bot token (xoxb-...) for the remote channel Slack adapter.
# SLACK_BOT_TOKEN=

# Slack app signing secret used to verify remote channel webhooks.
# SLACK_SIGNING_SECRET=

# Telegram bot token (from @BotFather) for the remote channel Telegram adapter.
# TELEGRAM_BOT_TOKEN=

# ── Web ingest & document parsing ──

# Firecrawl web crawling/scraping (knowledge-base ingestion).
# https://www.firecrawl.dev/app/api-keys
#   Create a key in the Firecrawl dashboard.
# FIRECRAWL_API_KEY=

# LlamaParse / LlamaCloud document parsing (OCR, tables).
# https://cloud.llamaindex.ai
#   Create a key in LlamaCloud → API keys.
# LLAMA_CLOUD_API_KEY=

# Mistral OCR document parsing (Document AI /v1/ocr).
# MISTRAL_API_KEY=

# Exa web search tool (optional; tool disabled when unset).
# https://dashboard.exa.ai/api-keys
#   Create a key in the Exa dashboard.
# EXA_API_KEY=

# Firecrawl API base URL override (self-hosted Firecrawl; cloud API when unset).
#   Set to the base URL of a self-hosted Firecrawl instance.
# FIRECRAWL_API_URL=

# ── Knowledge base ──

# Unsplash access key for article cover image search (picker hidden when unset).
# https://unsplash.com/oauth/applications
#   Create an app in the Unsplash developer dashboard and copy its Access Key.
# UNSPLASH_ACCESS_KEY=

# AI Gateway model id for cover image generation (built-in default when unset).
#   Set to an image-capable model id available through the configured AI gateway.
# AI_GATEWAY_IMAGE_MODEL=

# IANA timezone for source refresh schedules (falls back to TZ, then UTC).
#   Set to an IANA timezone name, e.g. Europe/Vienna.
# ENGENTY_KB_SOURCE_SCHEDULE_TZ=Europe/Vienna

# ── Memory — learning layer ──

# Set to true to run the bounded post-task reflection step (the specialist writes durable lessons via memory_save after each task run). Off by default.
# ENGENTY_AI_MEMORY_REFLECTION=

# ── Secrets ──

# AES-256-GCM key for secret payloads at rest (32 bytes, base64). Generate: engenty env generate (or openssl rand -base64 32). Phase 1 static key; superseded by per-tenant DEK + KMS in phase 2.
# SECRETS_ENC_KEY=

# ── Team-Chat — Slack Bridge ──

# Set to false to disable the team-chat Slack bridge (event replay + inbound sync).
# ENGENTY_TEAM_CHAT_SLACK_BRIDGE_ENABLED=
