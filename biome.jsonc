{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!**/generated-catalog.ts",
      "!**/generated-tailwind-sources.css",
      // Generated by apps/ui/scripts/favicons/generate-favicons.mjs — biome
      // reformatting it would drift from the generator's output on every run.
      "!apps/ui/public/favicon.svg",
      "!changelog.json",
      "!docs/dev/flows/index.html",
      // HTML/CSS click-dummy mockups — not product code; keep them out of ultracite.
      "!docs/internal/daybreak",
      "!docs/internal/space-home",
      "!docs/internal/work-model-map.html",
      "!scripts/codemod-actions-to-workflows.mjs",
      "!**/.devtools",
      "!.agent",
      "!.agents",
      "!.claude",
      "!.pi",
      "!.vibe",
      "!packages/ui-core/src/components/ui",
      "!apps/ui/src/components/ui"
    ]
  },
  "overrides": [
    {
      // The MV3 extension runs with the chrome.* extension APIs in scope.
      "includes": ["apps/browser-extension/**"],
      "javascript": { "globals": ["chrome"] }
    },
    {
      // Engenty agent hooks are NOT React hooks: state is string-keyed
      // (PLAN-agent-hooks D3), so conditional hook calls are legal by design
      // — the React rule's slot-indexing premise does not apply.
      "includes": [
        "packages/ai-core/src/hooks/**",
        "packages/ai-core/src/__tests__/agent-hooks.test.ts",
        "apps/ai/src/ai/agents/function-agents.ts",
        "apps/ai/src/ai/agents/function-agents/**",
        "apps/ai/src/__tests__/function-agent-provider.test.ts",
        "apps/ai/ai/agents/**"
      ],
      "linter": {
        "rules": { "correctness": { "useHookAtTopLevel": "off" } }
      }
    },
    {
      "includes": [
        "modules/**/src/dal/index.ts",
        "modules/**/ui/index.ts",
        "modules/**/ui/api.ts",
        "modules/**/ui/pages/index.ts",
        "modules/**/src/schema/index.ts",
        "modules/**/pages/portal/index.ts"
      ],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      "includes": ["modules/**"]
    },
    {
      "includes": ["modules/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noForEach": "off",
            "noVoid": "off"
          },
          "style": {
            "noNestedTernary": "off",
            "useDefaultSwitchClause": "off",
            "noNonNullAssertion": "off",
            "useFilenamingConvention": "off"
          },
          "performance": { "useTopLevelRegex": "off" },
          "correctness": {
            "noUnusedVariables": "off",
            "useExhaustiveDependencies": "off",
            "noUnusedFunctionParameters": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noEmptyBlockStatements": "off",
            "useAwait": "off",
            "useIterableCallbackReturn": "off",
            "noExplicitAny": "off"
          },
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "noStaticElementInteractions": "off",
            "noNoninteractiveElementInteractions": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useButtonType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/core/src/**",
        "packages/telemetry/src/**",
        "packages/ai-core/src/**",
        "packages/ui-core/src/**",
        "modules/**/src/**",
        "modules/**/ui/**"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "warn" }
        }
      }
    },
    {
      "includes": [
        "**/cli/**",
        "**/*.test.ts",
        "scripts/**",
        "**/scripts/**",
        "docs/**"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": ["apps/**", "packages/**", "scripts/**", "docs/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noForEach": "off",
            "noVoid": "off"
          },
          "style": {
            "noNestedTernary": "off",
            "useDefaultSwitchClause": "off",
            "noNonNullAssertion": "off",
            "useFilenamingConvention": "off"
          },
          "performance": { "useTopLevelRegex": "off", "noBarrelFile": "off" },
          "correctness": {
            "noUnusedVariables": "off",
            "useExhaustiveDependencies": "off",
            "noUnusedFunctionParameters": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noEmptyBlockStatements": "off",
            "useAwait": "off",
            "useIterableCallbackReturn": "off",
            "noExplicitAny": "off",
            "noImplicitAnyLet": "off",
            "noEvolvingTypes": "off"
          },
          "a11y": {
            "useButtonType": "off",
            "noStaticElementInteractions": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "security": { "noDangerouslySetInnerHtml": "off" }
        }
      }
    },
    {
      "includes": ["**/*.md"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
